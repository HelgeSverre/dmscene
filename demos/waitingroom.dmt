# ------------------------------------------------------------------ visuals
uniform flicker humBreath rainAmt kickE

frame {
  # fluorescent tube flicker: 60 Hz hum plus occasional dip
  f = 0.85 + 0.13 * sin(t * 377) + 0.05 * sin(t * 120)
  f = f * (1 - step(0.97, hash(floor(t * 30))) * 0.35)
  flicker = clamp(f, 0.45, 1.15)

  humBreath = 0.9 + 0.1 * sin(t * 0.9)
  rainAmt = 0.35 + 0.25 * sin(t * 0.07) + 0.15 * cenv(4)
  kickE = exp(-trig(0) * 6)
}

pixel {
  horizon = -0.08
  isFloor = step(0, horizon - v)
  isWall = 1 - isFloor

  dz = max(0.001, horizon - v)
  z = 0.28 / dz
  wx = u * z
  depthFade = exp(-z * 0.35)

  wallZ = 3.5
  wxWall = u * wallZ

  toneWall = 0.22 + 0.08 * isWall + 0.05 * sin(wxWall * 0.4)
  pal(night, toneWall)
  cadd(0.10, 0.11, 0.13)

  toneFloor = 0.20 + 0.05 * z + 0.04 * sin(wx * 0.5) + 0.10 * depthFade
  pal(night, mix(toneWall, toneFloor, isFloor))
  cadd(isFloor * 0.08, isFloor * 0.085, isFloor * 0.10)

  # floor tiles
  tileX = abs(fract(wx * 0.8 + 0.5) - 0.5)
  tileZ = abs(fract(z * 0.6) - 0.5)
  tile = exp(-tileX * tileX * 120 / (1 + z * 0.1)) * exp(-tileZ * tileZ * 80 / (1 + z * 0.1))
  cadd(tile * 0.10 * isFloor, tile * 0.10 * isFloor, tile * 0.12 * isFloor)

  # track edge line on the floor
  trackD = abs(wx - 0.55) / (1 + z * 0.15)
  track = exp(-trackD * trackD * 90)
  cadd(track * 0.06 * isFloor, track * 0.06 * isFloor, track * 0.07 * isFloor)

  # distant late-train headlight down the track
  trainPhase = 0.5 + 0.5 * sin(t * 0.15)
  trainX = 0.55
  trainZ = 8.0 + 4.0 * sin(t * 0.08)
  trainU = trainX / trainZ
  trainV = horizon - 0.28 / trainZ
  trainD = len(u - trainU, v - trainV)
  trainGlow = exp(-trainD * trainD * 600 / trainZ) * trainPhase * isFloor
  cadd(trainGlow * 0.35, trainGlow * 0.32, trainGlow * 0.22)

  # atmospheric haze / fog on the floor
  fog = fbm(wx * 0.5 + t * 0.02, z * 0.3, 3) * exp(-z * 0.4) * isFloor
  cadd(fog * 0.04, fog * 0.045, fog * 0.055)

  # receding pillars on the left
  pillarX = fract(wx * 0.22 + 0.5) - 0.5
  pillarZ = fract(z * 0.22) - 0.5
  pillarD = sdBox(pillarX * 2.2, pillarZ * 0.18 + 0.25, 0, 0.35, 0.12, 0.08)
  pillar = exp(-pillarD * pillarD * 110)
  cadd(pillar * 0.22, pillar * 0.23, pillar * 0.28)

  # ceiling fluorescent tubes
  tubeY = 0.22 + 0.04 * sin(wxWall * 0.3)
  tubeD = sdSegment(u, v, -0.8, tubeY, 0.8, tubeY)
  tube = exp(-tubeD * tubeD * 2600) * flicker
  cadd(tube * 1.2, tube * 1.25, tube * 1.3)

  # vending machine on the right wall
  vmZ = 3.2
  vmX = 0.55
  vmY = -0.06
  vmScale = wallZ / vmZ
  vmPx = (u - vmX) * vmScale
  vmPy = (v - vmY) * vmScale
  vmBody = sdBox(vmPx, vmPy, 0, 0, 0.18, 0.32)
  vmFill = step(vmBody, 0) * isWall
  vmGlow = exp(-vmBody * vmBody * 400) * vmFill

  # replace wall colour with amber inside the vending machine
  oldR = cget(0)
  oldG = cget(1)
  oldB = cget(2)
  pal(amber, 0.45 + 0.25 * sin(t * 0.4) + 0.15 * hash(floor(t * 8) * 0.1))
  cmul(humBreath)
  newR = cget(0)
  newG = cget(1)
  newB = cget(2)
  rgb(mix(oldR, newR, vmFill), mix(oldG, newG, vmFill), mix(oldB, newB, vmFill))
  cadd(vmGlow * 0.70, vmGlow * 0.35, 0)

  # internal vending lights
  liteY = vmPy + 0.20
  liteRow = abs(fract(liteY * 6) - 0.5)
  lite = vmFill * exp(-liteRow * liteRow * 100) * (0.6 + 0.4 * sin(t * 2 + liteY * 10))
  cadd(lite * 0.70, lite * 0.24, 0)

  # lone figure silhouette on the floor, centre-left
  figZ = 1.7
  figScale = z / figZ
  fx = (u + 0.12) * figScale
  fy = (v - horizon) * figScale + 0.30
  head = sdCircle(fx, fy - 0.50, 0, 0, 0.032)
  torso = sdBox(fx, fy - 0.21, 0, 0, 0.035, 0.18)
  leg1 = sdSegment(fx, fy, -0.018, 0.02, -0.025, -0.18)
  leg2 = sdSegment(fx, fy, 0.018, 0.02, 0.03, -0.18)
  figD = min(min(head, torso), min(leg1, leg2))
  fig = step(figD, 0) * isFloor * step(0.25, figScale) * (1 - step(2.2, figScale))
  cmul(1 - fig * 0.92)
  cadd(fig * 0.02, fig * 0.02, fig * 0.03)

  # rain on the glass: bright vertical streaks
  rx = x * 50 + fbm(t * 0.07, x * 4, 2) * 1.2
  ry = y * 80 - t * 6
  streak = fbm(rx, ry, 3)
  drop = pow(streak, 5) * rainAmt
  # water refraction shift
  refractU = u + drop * 0.02 * sin(ry * 4)
  refractV = v + drop * 0.015 * cos(rx * 3)
  refr = prev(refractU + 0.5, refractV + 0.5)
  cmul(1 - drop * 0.20)
  cadd(refr * 0.18 * drop, refr * 0.22 * drop, refr * 0.28 * drop)
  # extra bright streak highlights
  highlight = pow(streak, 18) * rainAmt
  cadd(highlight * 0.25, highlight * 0.28, highlight * 0.32)

  # wet floor reflection (only below horizon)
  reflU = u
  reflV = horizon + (horizon - v) * 0.65
  refl = prev(reflU + 0.5, reflV + 0.5)
  floorMask = step(0, horizon - v)
  cadd(refl * 0.20 * floorMask * (1 - v * 1.2), refl * 0.14 * floorMask * (1 - v * 1.2), refl * 0.08 * floorMask * (1 - v * 1.2))

  # subtle kick pulse in overall exposure
  cmul(0.92 + 0.08 * kickE)

  # vignette
  d = len(u, v * 0.8)
  cmul(1 - 0.25 * d * d)
}
