# mandel.dmt - swung lo-fi hip-hop while flying along the Mandelbrot boundary
title MANDELFLIGHT
song bpm=85 speed=6 rpb=4 channels=5 loop=0 volume=0.6
order 0 1 0 2

palette warm {
  0.00 0.02 0.01 0.03
  0.20 0.25 0.05 0.15
  0.40 0.90 0.35 0.10
  0.60 1.00 0.85 0.50
  0.80 0.30 0.50 0.60
  1.00 0.02 0.01 0.03
}

inst kick {
  f = 50 + 400 * exp(-t * 30)
  $p = $p + f / sr
  out(dist(sin($p * tau) * exp(-t * 5) * 1.8, 1.2) * 0.8)
}
inst snare {
  n = svf(noise(), 1500 + 2000 * exp(-t * 20), 0.4)
  out((r2 * 1.5 * exp(-t * 14) + sin(tau * 170 * t) * exp(-t * 30) * 0.5) * 0.6)
}
inst hat {
  out(hp(noise(), 7000) * exp(-t * (30 + 60 * (1 - vel))) * 0.2)
}
inst rhodes {
  e = env(0.003, 0.9, 0.2, 0.3)
  m = sin(ph * tau * 1.0) * (0.3 + 1.2 * exp(-t * 2.5)) + sin(ph * tau * 14) * 0.2 * exp(-t * 8)
  s = sin(ph * tau + m)
  s = s + sin(ph * tau * 2 + 0.3 * m) * 0.2
  out(s * e * 0.28)
}
inst bass {
  e = env(0.005, 0.3, 0.5, 0.15)
  s = sin(ph * tau) + tri(ph) * 0.5 + saw(ph) * 0.15
  s = svf(s, 180 + 400 * e, 0.2)
  out(s * e * 0.6)
}

master {
  # vinyl: crackle + hiss, then a gentle tape squash
  crackle = step(0.9992, hash(time * 7919 + l * 3)) * noise() * 0.25
  hiss = svf(noise(), 4000, 0.1) * 0.006
  d = dly(l * 0.5 + r * 0.5, 0.3529, 0.3)
  d = svf(d, 1200, 0.2)
  out(dist(l + d * 0.2 + crackle + hiss, 1.4), dist(r + d * 0.2 + crackle + hiss, 1.4))
}

# channels: 0 kick  1 snare  2 hats  3 rhodes  4 bass
# swing: speed 7 on the downbeat 16th, 5 on the offbeat (F07 / F05)
pattern 0 rows=16 {
  C-2 1 40 F07 | .        | C-6 3 26 | F-3 4 30 | F-1 5 40
  . . . F05 | .        | C-6 3 14 | A-3 4 26 | .
  . . . F07 | .        | C-6 3 22 | C-4 4 28 | .
  . . . F05 | .        | C-6 3 14 | E-4 4 24 | .
  . . . F07 | D-5 2 38 | C-6 3 26 | .        | .
  . . . F05 | .        | C-6 3 14 | .        | .
  . . . F07 | .        | C-6 3 22 | .        | F-1 5 30
  C-2 1 34 F05 | .        | C-6 3 14 | .        | .
  . . . F07 | .        | C-6 3 26 | .        | .
  . . . F05 | .        | C-6 3 14 | .        | .
  C-2 1 40 F07 | .        | C-6 3 22 | E-3 4 30 | E-1 5 40
  . . . F05 | .        | C-6 3 14 | G-3 4 26 | .
  . . . F07 | D-5 2 38 | C-6 3 26 | B-3 4 28 | .
  . . . F05 | .        | C-6 3 14 | D-4 4 24 | .
  . . . F07 | .        | C-6 3 22 | .        | .
  . . . F05 | D-5 2 20 | C-6 3 14 | .        | E-1 5 30
}
pattern 1 rows=16 {
  C-2 1 40 F07 | .        | C-6 3 26 | A-3 4 30 | A-1 5 40
  . . . F05 | .        | C-6 3 14 | C-4 4 26 | .
  . . . F07 | .        | C-6 3 22 | E-4 4 28 | .
  . . . F05 | .        | C-6 3 14 | G-4 4 24 | .
  . . . F07 | D-5 2 38 | C-6 3 26 | .        | .
  . . . F05 | .        | C-6 3 14 | .        | .
  . . . F07 | .        | C-6 3 22 | .        | A-1 5 30
  C-2 1 34 F05 | .        | C-6 3 14 | .        | .
  . . . F07 | .        | C-6 3 26 | .        | .
  C-2 1 30 F05 | .        | C-6 3 14 | .        | .
  C-2 1 40 F07 | .        | C-6 3 22 | D-3 4 30 | D-1 5 40
  . . . F05 | .        | C-6 3 14 | F-3 4 26 | .
  . . . F07 | D-5 2 38 | C-6 3 26 | A-3 4 28 | .
  . . . F05 | .        | C-6 3 14 | C-4 4 24 | .
  . . . F07 | .        | C-6 3 22 | .        | D-1 5 30
  . . . F05 | .        | C-6 3 14 | .        | .
}
pattern 2 rows=16 {
  C-2 1 40 F07 | .        | C-6 3 26 | G-3 4 30 | G-1 5 40
  . . . F05 | .        | C-6 3 14 | B-3 4 26 | .
  . . . F07 | .        | C-6 3 22 | D-4 4 28 | .
  . . . F05 | .        | C-6 3 14 | F-4 4 24 | .
  . . . F07 | D-5 2 38 | C-6 3 26 | .        | .
  . . . F05 | .        | C-6 3 14 | .        | .
  . . . F07 | .        | C-6 3 22 | .        | G-1 5 30
  C-2 1 34 F05 | .        | C-6 3 14 | .        | .
  . . . F07 | .        | C-6 3 26 | .        | .
  . . . F05 | .        | C-6 3 14 | .        | .
  C-2 1 40 F07 | .        | C-6 3 22 | C-3 4 30 | C-1 5 40
  . . . F05 | .        | C-6 3 14 | E-3 4 26 | .
  . . . F07 | D-5 2 38 | C-6 3 26 | G-3 4 28 | .
  . . . F05 | .        | C-6 3 14 | B-3 4 24 | .
  . . . F07 | D-5 2 24 | C-6 3 22 | .        | .
  . . . F05 | D-5 2 34 | C-6 3 14 | .        | C-1 5 30
}

uniform cx cy zoom kickE snareE rhE hue

frame {
  kickE = exp(-trig(0) * 6)
  snareE = exp(-trig(1) * 8)
  rhE = exp(-trig(3) * 4)
  # fly between three boundary points over the loop
  ph = fract(lbeat / llen) * 3
  seg = floor(ph)
  f = smooth(0, 1, ph - seg)
  ax = seg == 0 ? -0.1011 : (seg == 1 ? -0.7453 : 0.2820)
  ay = seg == 0 ? 0.9563 : (seg == 1 ? 0.1127 : -0.0100)
  bx = seg == 0 ? -0.7453 : (seg == 1 ? 0.2820 : -0.1011)
  by = seg == 0 ? 0.1127 : (seg == 1 ? -0.0100 : 0.9563)
  cx = mix(ax, bx, f)
  cy = mix(ay, by, f)
  travel = 4 * f * (1 - f)                       # zoom out while travelling
  zoom = 60 - 56 * travel + kickE * 2
  hue = bar * 0.02
}
pixel {
  zx = cx + u / zoom
  zy = cy + v / zoom
  it = mandel(zx, zy, 160)
  trap = r1
  cross = r2
  k = log(1 + it) / log(161)
  inside = step(160, it)
  pal(warm, k * 2 + hue + cross * 0.1)
  cmul((0.08 + 1.3 * k * k) * (1 - inside))
  # star-like point traps twinkle with the rhodes
  s = exp(-trap * 12) * (0.3 + 0.9 * rhE)
  cadd(s, s * 0.85, s * 0.6)
  cadd(inside * kickE * 0.15, inside * kickE * 0.05, 0)
  # film grain and a soft vignette
  gr = (hash(x * 977 + y * 1511 + frame) - 0.5) * 0.06
  cadd(gr, gr, gr)
  d = len(u, v)
  cmul(1 - 0.4 * d * d)
  cprev(x, y, 0.35 * snareE)
}
