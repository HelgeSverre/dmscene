# DEPARTURE — 04:00, opposite platform, no train.
# A single miniature set rendered with 2D signed-distance geometry.  The post
# pass is the wet glass in front of the camera.  Fifteen bars at 120 BPM = 30 s.
title DEPARTURE
song bpm=120 speed=6 rpb=4 channels=7 loop=0 volume=0.60 scale=2 dither=1
order 0 0 1 2 3 0 1 4 0 1 2 3 0 5 6
pan 0.50 0.64 0.46 0.34 0.55 0.66 0.58

text heading "DEPARTURE"
text delayed "DELAYED"
text clock "04:00"
text drinks "DRINKS"
text platform "PLATFORM 2"

# ---------------------------------------------------------------------- sound
inst rail {
  f = 43 + 150 * exp(-t * 19)
  $p = $p + f / sr
  body = sin($p * tau) * exp(-t * 3.7)
  sub = sin($p * tau * 0.50) * exp(-t * 2.8) * 0.35
  air = lp(noise(), 180) * exp(-t * 5.0) * 0.16
  out(dist((body + sub) * 1.25 + air, 1.18) * 0.48)
}

inst drip {
  n = hp(noise(), 6200)
  ping = sin(tau * (1450 + 900 * vel) * t) * exp(-t * 55) * 0.15
  out((n * 0.55 + ping) * exp(-t * (38 + 45 * (1 - vel))) * 0.24)
}

inst bass {
  e = env(0.018, 0.34, 0.64, 0.42)
  s = sin(ph * tau) + tri(ph) * 0.24 + sin(ph * tau * 2.003) * 0.12
  s = lp(s, 155 + 360 * e)
  out(s * e * 0.40)
}

inst pad nna=continue {
  e = env(0.48, 0.72, 0.72, 1.35)
  a = sin(ph * tau + 0.22 * sin(ph * tau * 0.5 + t * 0.23))
  b = tri(ph + 0.0015 * t) + tri(ph - 0.0019 * t)
  s = a * 0.62 + b * 0.18 + sin(ph * tau * 2.002) * 0.09
  s = svf(s, 390 + 260 * e + 80 * sin(t * 0.31), 0.24)
  out(s * e * 0.22)
}

inst bell nna=continue {
  e = exp(-t * 1.18) * smooth(0.0, 0.008, t)
  m = sin(ph * tau * 2.007) * (1.45 * exp(-t * 2.8) + 0.12)
  s = sin(ph * tau + m) + sin(ph * tau * 2.004 + m * 0.22) * 0.28
  s = s + sin(ph * tau * 3.991) * exp(-t * 4.0) * 0.10
  out(s * e * 0.20)
}

chan 3 {
  w = verb(x, 0.84, 0.52)
  out(x * 0.84 + w * 0.42)
}
chan 4 {
  w = verb(x, 0.86, 0.48)
  out(x * 0.82 + w * 0.44)
}
chan 5 {
  w = verb(x, 0.85, 0.50)
  out(x * 0.84 + w * 0.40)
}
chan 6 {
  d = dly(x, 0.375, 0.34)
  w = verb(x + d * 0.18, 0.87, 0.43)
  out(x + d * 0.30 + w * 0.40)
}

master {
  dl = dly(l, 0.375, 0.24)
  dr = dly(r, 0.750, 0.22)
  vl = verb(l + dr * 0.10, 0.82, 0.53)
  vr = verb(r + dl * 0.10, 0.82, 0.53)
  # Rain and two mains-related sounds are room tone, not a fade-out device.
  gust = 0.78 + 0.14 * sin(time * 0.29) + 0.08 * sin(time * 0.73 + 1.2)
  nl = noise()
  nr = noise()
  rainl = (hp(nl, 2700) * 0.021 + lp(nl, 520) * 0.012) * gust
  rainr = (hp(nr, 2900) * 0.021 + lp(nr, 480) * 0.012) * gust
  buzz = 0.68 + 0.32 * hash(floor(time * 31))
  hum = (sin(time * tau * 60) * 0.009 + sin(time * tau * 120 + 0.3) * 0.004) * buzz
  motor = sin(time * tau * 47 + 0.6 * sin(time * 0.4)) * 0.004
  ol = l + dr * 0.14 + vl * 0.14 + rainl + hum + motor
  or = r + dl * 0.14 + vr * 0.14 + rainr + hum * 0.92 + motor
  out(dist(hp(ol, 28) * 1.06, 1.16), dist(hp(or, 28) * 1.06, 1.16))
}

# --------------------------------------------------------------- tracker score
# 16 rows = one two-second bar.  ch0 rail, ch1 drips, ch2 bass,
# ch3/4/5 pad triad, ch6 bells.  No notes are released in the final bar.
pattern 0 rows=16 {
  00: C-2 1 24 ... | C-6 2 0B ... | D-2 3 26 ... | D-3 4 20 ... | F-3 4 1B ... | A-3 4 18 ... | D-5 5 14 ...
  01: . | . | . | . | . | . | .
  02: . | C-6 2 07 ... | . | . | . | . | .
  03: . | . | . | . | . | . | .
  04: . | C-6 2 0A ... | . | . | . | . | A-4 5 0E ...
  05: . | . | . | . | . | . | .
  06: . | C-6 2 06 ... | . | . | . | . | .
  07: . | . | . | . | . | . | .
  08: C-2 1 1C ... | C-6 2 09 ... | . | . | . | . | F-5 5 12 ...
  09: . | . | . | . | . | . | .
  10: . | C-6 2 07 ... | . | . | . | . | .
  11: . | . | . | . | . | . | .
  12: . | C-6 2 0A ... | . | . | . | . | E-5 5 0D ...
  13: . | . | . | . | . | . | .
  14: . | C-6 2 06 ... | . | . | . | . | .
  15: . | . | . | . | . | . | .
}
