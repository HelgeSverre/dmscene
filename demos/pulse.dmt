# @collection Demos
# @music house: FM kick, FM bass, pluck arps, pad, stereo echo
# @visual Julia set whose c orbits the cardioid; kaleidoscope fold; orbit-trap glow on the arp
# pulse.dmt - a loopable fractal demo for dmscene.
# Everything below compiles into one byte-packed .dms: five VM instruments,
# four tracker patterns, a master effect, two palettes and a two-stage shader.

title PULSE
song bpm=128 speed=6 rpb=4 channels=5 loop=1 volume=0.62
order 0 1 2 1 3

# ------------------------------------------------------------------ palettes
palette nebula {
  0.00  0.01 0.00 0.05
  0.18  0.10 0.00 0.35
  0.38  0.75 0.10 0.45
  0.55  1.00 0.55 0.10
  0.72  0.95 0.95 0.70
  0.86  0.10 0.60 0.80
  1.00  0.01 0.00 0.05
}
palette ice {
  0.00  0.00 0.02 0.08
  0.30  0.00 0.35 0.60
  0.60  0.60 0.95 1.00
  0.80  1.00 1.00 1.00
  1.00  0.00 0.02 0.08
}

# ------------------------------------------------------------------ instruments
# inst programs run once per sample per voice.
#   t = seconds since note-on, rel = seconds since note-off (-1 while held)
#   ph = phase 0..1 at the channel's current pitch, vel = note-on velocity
#   $name = per-voice state slot (zeroed on trigger)

inst kick {
  f  = 48 + 520 * exp(-t * 38)          # pitch sweep
  $p = $p + f / sr                      # own phase accumulator (ignores pattern pitch)
  body  = sin($p * tau) * exp(-t * 6.5)
  click = noise() * exp(-t * 120) * 0.6
  out(dist((body + click) * 2.2, 1.5) * 0.8)
}

inst snare {
  n = hp(noise(), 1500) * exp(-t * 14)
  tone = sin(tau * 185 * t) * exp(-t * 32)
  out((n * 0.8 + tone * 0.6) * 0.7)
}

inst hat {
  n = hp(noise(), 8000)
  d = 30 + 80 * (1 - vel)               # quieter hats are also shorter
  out(n * exp(-t * d) * 0.35)
}

inst bass {
  e  = env(0.003, 0.22, 0.35, 0.08)
  mi = 2.5 * exp(-t * 6) + p0 * 6       # fm index: decays, Sxx opens it back up
  m  = sin(ph * tau * 2) * mi
  s  = sin(ph * tau + m) + saw(ph) * 0.25
  s  = lp(s, 250 + 2800 * e)
  out(s * e * 0.55)
}

inst pluck {
  e  = env(0.001, 0.16, 0.0, 0.05)
  pw = 0.5 + 0.35 * sin(t * 9)
  s  = sqr(ph, pw) * 0.55 + saw(ph * 2 + 0.25) * 0.45
  s  = lp(s, 400 + 7000 * e)
  out(s * e * 0.32)
}

inst pad {
  e = env(0.35, 0.6, 0.7, 0.7)
  a = sin(ph * tau + 0.7 * sin(ph * tau * 0.5 + t * 0.5))
  b = saw(ph + 0.0021 * t) * 0.5 + saw(ph - 0.0017 * t) * 0.5     # two detuned saws
  s = lp(a + b * 0.6, 350 + 900 * e + 250 * sin(t * 1.7))
  out(s * e * 0.28)
}

# ------------------------------------------------------------------ master
# l / r come in, out(l, r) goes to the speakers.  dly() lines only exist here.
master {
  dl = dly(l, 0.2344, 0.38)       # dotted-ish echoes at 128 bpm
  dr = dly(r, 0.3516, 0.34)
  ol = l + dr * 0.22
  or = r + dl * 0.22
  out(dist(ol, 1.2), dist(or, 1.2))
}

# ------------------------------------------------------------------ patterns
# channels:  0 kick(1)  1 snare(2)/hat(3)  2 bass(4)  3 pluck(5)  4 pad(6)
# cell: note inst vol fx     '.' = none

