# ------------------------------------------------------------------ visuals
# frame runs once per frame and publishes uniforms; pixel reads them.
uniform zoom ang cx cy hue kickE glow mixk fold

frame {
  k = exp(-trig(0) * 7)                      # kick envelope
  kickE = k
  sn = exp(-trig(1) * 10) * step(0.5, vel(1))  # snare only (hats have low velocity)
  pl = exp(-trig(3) * 9)                     # pluck envelope
  glow = pl * 0.9 + sn * 0.5

  # julia parameter orbits the cardioid boundary: always a lively set
  a  = beat * 0.045 * tau + 0.25 * sin(beat * 0.11) + 0.08 * k
  rr = 0.7885 + 0.012 * sin(beat * 0.37)
  cx = rr * cos(a)
  cy = rr * sin(a)

  # camera: slow breathing + kick punch + bar-wise rotation
  zoom = 0.78 + 0.06 * sin(beat * 0.5 * pi) + 0.12 * k
  ang  = beat * 0.03 + 0.4 * sin(beat * 0.07)
  hue  = bar * 0.06 + pl * 0.05
  mixk = 0.5 + 0.5 * sin(lbeat / llen * tau)     # palette crossfade across the loop
  fold = smooth(0.1, 0.9, 0.5 + 0.5 * sin(beat * 0.0625 * pi))   # kaleidoscope amount
}

pixel {
  # rotate + zoom view space
  px = rot(u, v, ang)
  py = r1
  # kaleidoscope fold (mirror across x when fold is up)
  px = mix(px, abs(px), fold)
  zx = px / zoom
  zy = py / zoom

  it = julia(zx, zy, cx, cy, 72)
  trap  = r1
  cross = r2

  k = it / 72
  inside = step(1, k)                        # 1 inside the set
  near = log(1 + it * 0.5) / log(37)         # 0 far from the set, 1 at its boundary (log scale)
  tone = near * 2.4 + hue + cross * 0.08
  pal(nebula, tone)
  mixpal(ice, tone + 0.1, mixk * 0.7)

  # brightness: edges pop, deep interior stays dark but pulses with the kick
  cmul(mix(0.12 + 0.5 * kickE, 0.08 + 1.6 * near ^ 1.5, 1 - inside))

  # orbit-trap glow follows the arp
  g = exp(-trap * 6) * glow * (1 - inside)
  cadd(g * 0.9, g * 0.5, g * 0.2)

  # subtle vignette + centre flash on kick
  d = len(u, v)
  cmul(1 - 0.35 * d * d)
  cadd(kickE * 0.08 * exp(-d * 2), kickE * 0.03, kickE * 0.1 * exp(-d * 2))
}
