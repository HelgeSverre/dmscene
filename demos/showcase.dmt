# Full-screen kinetic type. Each glyph gets its own bounce, squash and rotation.
fn kinetic(s, px, py, sz, bend) {
  rx = rot(u - px, v - py, 0.12 * sin(beat * 0.7) * bend)
  ry = r1
  cell = sz * (1 + 0.09 * kickE)
  cx = rx / cell
  ix = floor(cx)
  cy = (-ry + bend * 0.12 * sin(ix * 0.8 - beat * 1.8)) / (cell * 1.3333 * (1 + bend * 0.28 * sin(ix - beat)))
  flip = mix(1, cos(beat * 0.65 + ix * 0.18), (section == 1) || (section == 7))
  gx = rot((fract(cx) - 0.5) * sign(flip) / max(abs(flip), 0.12), cy - 0.5, bend * 0.38 * sin(ix * 1.2 + beat))
  gy = r1
  return glyph(str(s, ix), gx + 0.5, gy + 0.5) * step(0, cx) * step(cx, strlen(s))
}
fn headline(s, py, sz, bend) {
  left = -strlen(s) * sz * 0.5
  shadow = 0
  repeat k 4 {
    shadow += kinetic(s, left + (k + 1) * 0.012, py - (k + 1) * 0.013, sz, bend)
  }
  ink = kinetic(s, left, py, sz, bend)
  cadd(shadow * 0.075, shadow * 0.035, shadow * 0.18)
  cadd(ink * (0.65 + 0.35 * sin(u * 3 + beat * 0.4)), ink * (0.75 + 0.25 * cos(u * 2 - beat)), ink)
}
fn pagecode(i) {
  code = str(page0, i)
  code = mix(code, str(page1, i), section == 1)
  code = mix(code, str(page2, i), section == 2)
  code = mix(code, str(page3, i), section == 3)
  code = mix(code, str(page4, i), section == 4)
  code = mix(code, str(page5, i), section == 5)
  code = mix(code, str(page6, i), section == 6)
  code = mix(code, str(page7, i), section == 7)
  return code
}
fn meter(c) {
  return cenv(0) * (c == 0) + cenv(1) * (c == 1) + cenv(2) * (c == 2) + cenv(3) * (c == 3) + cenv(4) * (c == 4) + cenv(5) * (c == 5) + cenv(6) * (c == 6) + cenv(7) * (c == 7)
}
fn ringfield(px, py, rate) {
  rr = max(len(px, py), 0.006)
  aa = atan2(py, px)
  z = log(rr) * 1.442695 + beat * rate
  ring = exp(-abs(fract(z) - 0.5) * 32)
  spoke = exp(-abs(sin(aa * 6 + z * 1.5 - beat * 0.3)) * 24)
  return ring * 0.6 + spoke * 0.5
}
fn donut(px, py, pz) {
  zz = (fract((pz + beat * 0.24) * 0.45) - 0.5) / 0.45
  rx = rot(px, py, zz * 1.7 + beat * 0.3)
  ry = r1
  return len(len(rx, ry * 1.12) - 0.64, zz) - 0.17
}
frame {
  kickE = exp(-trig(0) * 15) * step(0.01, vel(0))
  snareE = exp(-trig(1) * 15) * step(0.01, vel(1))
  arpE = exp(-trig(5) * 16)
  section = evt(chapter)
  energy = evtl(drive)
  phase = fract(beat / 16)
  spin = beat * 0.18 + sin(beat * 0.17) * 0.7
  zoomer = 2 ^ fract(beat / 8)
  select(section)
}

pixel boot {
  # Log-polar rings never reach an endpoint: translation in log space is zoom.
  rx = rot(u, v, spin * 0.35)
  ry = r1
  rings = ringfield(rx, ry, 0.32)
  a = atan2(ry, rx)
  pal(neon, log(max(len(rx, ry), 0.01)) * 0.16 - beat * 0.035 + a * 0.12)
  cmul(0.13 + rings * (0.65 + 0.25 * kickE))
  # Three title copies travel toward the camera; another replaces each escaping copy.
  repeat i 3 {
    z = 2 ^ (fract(beat / 12 + i / 3) * 3 - 1.5)
    ink = kinetic(logo, -1.12 * z, 0.22 * z, 0.32 * z, 1.1)
    fade = (1 - abs(fract(beat / 12 + i / 3) * 2 - 1)) * 0.65
    cadd(ink * fade * 0.5, ink * fade, ink * fade)
  }
  headline(logo, 0.17 + sin(beat * 0.5) * 0.14, 0.31, 1)
}
pixel circuit {
  rr = max(len(u, v), 0.02)
  aa = atan2(v, u) + spin * 0.8
  depth = log(rr) * 1.8 + beat * 0.7
  bx = fract(aa * 3.82 + depth * 0.2)
  by = fract(depth)
  chip = step(0.12, bx) * step(bx, 0.88) * step(0.12, by) * step(by, 0.88)
  edge = exp(-min(min(bx, 1 - bx), min(by, 1 - by)) * 55)
  pal(neon, floor(aa * 3.82) * 0.07 + floor(depth) * 0.09 + beat * 0.018)
  cmul(0.17 + chip * 0.6 + edge * (0.7 + kickE * 0.3))
  headline(ignite, 0.2 + 0.17 * sin(beat * 0.4), 0.17, 1.4)
}
pixel tracker {
  aa = atan2(v, u) + spin * 0.5
  sector = floor(fract(aa / tau) * 8)
  level = meter(sector)
  rr = len(u, v)
  radius = 0.48 + min(level * 1.2, 0.65)
  spoke = exp(-abs(fract(aa / tau * 8) - 0.5) * 11)
  bars = step(0.3, rr) * step(rr, radius) * spoke
  rings = ringfield(u, v, 0.52)
  pal(neon, sector * 0.09 + rr * 0.16 - beat * 0.02)
  cmul(0.16 + bars * 1.2 + rings * 0.6)
  headline(clocked, 0.18 + 0.06 * sin(beat), 0.18, 1.2)
}
pixel fractals {
  # Two staggered zooms trade off before either resets, staying within float precision.
  p = fract(beat / 12)
  q = fract(beat / 12 + 0.5)
  z1 = 2 ^ (p * 10)
  z2 = 2 ^ (q * 10)
  rx = rot(u, v, spin * 0.16)
  ry = r1
  n1 = mandel(-0.7436439 + rx * 1.7 / z1, 0.1318259 + ry * 1.7 / z1, 32)
  trap1 = r2
  n2 = mandel(-0.7436439 + rx * 1.7 / z2, 0.1318259 + ry * 1.7 / z2, 32)
  trap2 = r2
  blend = smooth(0.05, 0.42, p) * (1 - smooth(0.55, 0.92, p))
  n = mix(n2, n1, blend)
  trap = mix(trap2, trap1, blend)
  pal(neon, n * 0.037 - beat * 0.025)
  cmul(0.45 + 0.65 * exp(-trap * 18))
  # A folded ring cage adds a second, fast recursive scale to the slow deep zoom.
  rings = ringfield(u, v, 0.8)
  cadd(rings * 0.08, rings * 0.18, rings * 0.13)
  headline(infinite, 0.13 + 0.1 * sin(beat * 0.3), 0.16, 1.1)
}
pixel solid {
  # Fly through a periodic chain of twisted tori instead of staring at one object.
  dx = u + 0.13 * sin(beat * 0.4)
  dy = v + 0.13 * cos(beat * 0.5)
  dz = 1.3
  dl = len(len(dx, dy), dz)
  dx /= dl
  dy /= dl
  dz /= dl
  travel = 0
  d = 1
  repeat j 22 {
    px = dx * travel
    py = dy * travel
    pz = -2.8 + dz * travel
    d = donut(px, py, pz)
    travel += clamp(d, 0.002, 0.35) * step(0.004, d)
  }
  hit = step(d, 0.035) * step(travel, 7)
  bands = 0.6 + 0.4 * sin(atan2(py, px) * 9 + pz * 7 - beat)
  pal(neon, travel * 0.18 + bands * 0.15 - beat * 0.025)
  cmul(hit * (0.35 + bands * 0.6))
  rings = ringfield(u, v, 0.35)
  cadd((1 - hit) * rings * 0.2, (1 - hit) * rings * 0.15, (1 - hit) * rings * 0.35)
  headline(mantra, 0.22 + 0.14 * cos(beat * 0.3), 0.155, 0.8)
}
pixel memory {
  rr = len(u, v)
  aa = atan2(v, u)
  seed = exp(-abs(rr - 0.45 - 0.13 * sin(aa * 6 - beat)) * 55)
  pal(neon, aa * 0.16 + beat * 0.04)
  cmul(seed * (0.3 + arpE * 0.6))
  # Pixel text participates in the actual previous-frame zoom/rotation.
  cprevz(0.5, 0.45, 1.045 + kickE * 0.009, 0.035 + 0.01 * sin(beat), 0.89 * step(y, 0.82) * step(0.025, phase))
  headline(logo, 0.15 + 0.18 * sin(beat * 0.4), 0.3, 1.5)
}
pixel hyperspace {
  rx = u + 0.18 * sin(beat * 0.4)
  ry = v + 0.16 * cos(beat * 0.3)
  rr = max(len(rx, ry), 0.025)
  aa = atan2(ry, rx) + spin * 0.9
  zz = 0.7 / rr + beat * 1.5
  ribs = exp(-abs(sin(zz * 4)) * 17)
  rails = exp(-abs(sin(aa * 9 + zz * 0.45)) * 28)
  tiles = vor(aa * 4, zz * 0.8)
  star = step(0.975, hash(floor(aa * 38) + floor(zz) * 51)) * exp(-abs(fract(zz) - 0.5) * 8)
  pal(neon, aa * 0.12 + zz * 0.055 - beat * 0.018)
  cmul(0.1 + (ribs * 0.75 + rails * 0.9 + tiles * 0.18) * min(rr * 3, 1))
  cadd(star * 0.7, star * 0.85, star)
  headline(infinite, 0.13 + sin(beat * 0.5) * 0.1, 0.17, 1.5)
}
pixel finale {
  z = 2 ^ (fract(beat / 8) * 2)
  rx = rot(u * z, v * z, spin * 0.6)
  ry = r1
  fx = rx
  fy = ry
  repeat i 5 {
    fx = abs(fx) - 0.52
    fy = abs(fy) - 0.34
    tx = rot(fx, fy, 0.65 + 0.15 * sin(beat * 0.15))
    fy = r1 * 1.6
    fx = tx * 1.6
  }
  d = len(fx, fy)
  edge = exp(-abs(d - 0.7) * 10)
  lattice = exp(-abs(fx) * 9) + exp(-abs(fy) * 9)
  pal(neon, d * 0.07 + beat * 0.025)
  cmul(0.2 + edge * 0.85 + lattice * 0.3)
  headline(send, 0.18 + 0.13 * sin(beat * 0.5), 0.165, 1.5)
}
post {
  # The full picture bends and splits on the snare. No permanent letterbox panels.
  shift = floor(snareE * 3 * sin(y * 55 + beat))
  red = tap(-2 - shift, 0)
  green = r1
  blue = r2
  plus = tap(2 + shift, 0)
  pg = r1
  pb = r2
  rgb(cget(0) * 0.86 + red * 0.18, cget(1) * 0.92 + (green + pg) * 0.06, cget(2) * 0.87 + pb * 0.18)
  cmul((1 - 0.07 * step(0.5, fract(y * h * 0.5))) * max(0.6, 1 - 0.08 * len(u, v)))
  # The chapter label lands from the left, then its letters ripple with the beat.
  entrance = (1 - smooth(0, 0.055, phase)) * 0.8
  cx = (x - 0.025 + entrance) / 0.017
  ix = floor(cx)
  cy = (y - 0.035 - 0.0025 * sin(ix * 0.5 - beat)) / (0.017 * aspect * 1.3333)
  code = pagecode(ix)
  titleInk = glyph(code, fract(cx), cy) * step(0, cx) * step(cx, 54)
  strip = step(y, 0.085)
  cmul(1 - strip * 0.72)
  cadd(titleInk * 0.45, titleInk, titleInk * 0.9)
  # One command/feature line per four beats; type-on and letter bounce replace four static rows.
  line = 1 + floor(fract(beat / 16) * 4)
  localbeat = fract(beat / 4)
  slide = (1 - smooth(0, 0.16, localbeat)) * 0.07
  cc = (x - 0.025 - slide) / 0.0175
  ci = floor(cc)
  yy = (y - 0.865 - 0.0025 * sin(ci * 0.7 - beat * 2) * snareE) / (0.0175 * aspect * 1.3333)
  code = pagecode(line * 54 + ci)
  ink = glyph(code, fract(cc), yy) * step(0, cc) * step(cc, 54) * step(ci, 54 * smooth(0, 0.48, localbeat))
  floorPanel = smooth(0.83, 0.85, y)
  cmul(1 - floorPanel * 0.82)
  cadd(ink * 0.8, ink, ink)
  cursor = step(abs(cc - min(53, floor(54 * smooth(0, 0.48, localbeat)))), 0.18) * step(0, yy) * step(yy, 1)
  cadd(cursor * 0.4, cursor, cursor * 0.5)
  # A continuous sine scroller carries every CLI command through the foreground.
  crawlx = x / 0.0125 + beat * 1.7
  crawly = (y - 0.952 - 0.006 * sin(x * 10 + beat)) / (0.0125 * aspect * 1.3333)
  sc = glyph(str(crawl, floor(crawlx) % strlen(crawl)), fract(crawlx), crawly)
  cadd(sc * 0.55, sc * 0.9, sc * 0.65)
  rule = step(abs(y - 0.827), 0.0015)
  cadd(rule * 0.2, rule * (0.3 + 0.7 * step(x, phase)), rule * 0.8)
}
