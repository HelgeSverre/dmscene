# ------------------------------------------------------------------ visuals
timeline {
  0:00  cam=0 fog=1 glow=0.5
  2:00  glow=1.0
  4:00  cam=1 glow=1.3
  6:00  cam=2 glow=0.9
  8:00  cam=3 glow=1.6
  10:00 glow=0.7
  12:00 glow=0.3
}

fn textline(s, px, py, sz) {
  cx = (u - px) / sz
  cy = (py - v) / sz
  i = floor(cx)
  return glyph(str(s, i), fract(cx), fract(cy)) * step(0, cx) * step(cx, strlen(s)) * step(0, cy) * step(cy, 1)
}

uniform kickE snE bellE cam fog glow

frame {
  kickE = exp(-trig(0) * 8)
  snE = exp(-trig(1) * 10) * step(0.5, vel(1))
  bellE = exp(-trig(5) * 5)
  cam = evtl(cam)
  fog = evtl(fog)
  glow = evtl(glow) + kickE * 0.25 + snE * 0.15 + bellE * 0.2
}

pixel {
  # --- stone wall background ---
  stone = fbm(u * 2.2 + beat * 0.008, v * 1.8 - beat * 0.004, 4)
  pal(bone, stone * 0.28 + 0.12 + cam * 0.015)

  # --- rose window (stained glass) ---
  wx = u * 2.2
  wy = (v - 0.28) * 2.2
  wd = len(wx, wy)
  mask = step(wd, 0.92) * step(0.05, v)
  ring = exp(-abs(wd - 0.86) * 45)
  it = kali(wx, wy, 0.78 + 0.05 * sin(beat * 0.1), 0.62, 10)
  tone = 0.20 + log(1 + it) * 0.30 + beat * 0.025 + cam * 0.03
  pal(glass, tone)
  win_r = cget(0)
  win_g = cget(1)
  win_b = cget(2)
  # restore stone and blend
  pal(bone, stone * 0.28 + 0.12 + cam * 0.015)
  cmul(1 - mask * 0.92)
  win = mask * (0.7 + 0.35 * ring)
  cadd(win_r * win, win_g * win, win_b * win)
  # bone frame around the window
  cadd(ring * 0.40, ring * 0.36, ring * 0.28)

  # --- ribbed bone vaults (domain-repeated arches) ---
  repeat i 4 {
    rx = fract(u * (0.8 + i * 0.25) + 0.5) - 0.5
    ry = v - 0.18 - i * 0.05
    arc = abs(len(rx * (2.2 + i * 0.4), ry)) - (0.32 + i * 0.04)
    rib = exp(-arc * arc * (70 + i * 20))
    cadd(rib * 0.40, rib * 0.36, rib * 0.28)
  }

  # --- perspective floor and columns ---
  floor = step(v, 0)
  depth = 1 / (0.08 - v * 0.5 + 0.02)
  wxf = u * depth * 0.45
  gz = depth + beat * 0.15
  gx = abs(fract(wxf * 2) - 0.5)
  gzline = abs(fract(gz * 0.5) - 0.5)
  fgrid = (exp(-gx * 14) + exp(-gzline * 14)) * floor
  cadd(fgrid * 0.15, fgrid * 0.14, fgrid * 0.11)

  colx = fract(wxf * 0.5 + 0.5) * 2 - 1
  colw = 0.08 * depth
  col = step(abs(colx), colw) * floor * step(depth, 9)
  cadd(col * 0.18, col * 0.16, col * 0.13)

  # --- light shafts from above ---
  angle = atan2(u, v - 0.55)
  shaft = abs(fract(angle * 3 / tau + beat * 0.035 + cam * 0.08) - 0.5)
  beam = exp(-shaft * 28) * step(0.12, v) * (0.05 + glow * 0.05)
  cadd(beam * 0.85, beam * 0.75, beam * 0.55)

  # --- sparse dust motes ---
  dust = step(0.997, hash(floor(u * 100) + floor(v * 100) * 101 + floor(beat * 6))) * (0.04 + glow * 0.04)
  cadd(dust, dust * 0.95, dust * 0.8)

  # --- title inscription ---
  ttl = textline(word, -1.05, -0.72, 0.24)
  cadd(ttl * 0.90, ttl * 0.83, ttl * 0.68)

  # --- atmospheric feedback (very slight ghost) ---
  drift = 0.003 * sin(beat * 0.08 + cam)
  cprevz(0.5, 0.5, 1.001 + kickE * 0.0005, drift, 0.04 + glow * 0.02)

  # --- kick flash and snare tint ---
  cadd(kickE * 0.04, kickE * 0.035 + snE * 0.015, kickE * 0.03 + snE * 0.01)
}

post {
  # soft bloom and vignette
  b = tap(-1, 0) + tap(1, 0) + tap(0, -1) + tap(0, 1)
  bl = b * 0.25
  rgb(cget(0) + bl * 0.25, cget(1) + bl * 0.20, cget(2) + bl * 0.16)
  d = len(u, v)
  cmul(1 - 0.30 * d * d)
}
