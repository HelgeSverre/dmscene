# @model Kimi K2.7 Code
# @collection Written by the models
# @music gothic rave in D minor: deep kick, snare, 8th hats, organ bass, choir arpeggios, bell melody over Dm–B♭–F–C
# @visual inside a bone nave: a kaleidoscopic kali rose window, domain-repeated SDF arches and ribbed vaults, a receding floor grid, columns, rotating light shafts and dust; bloom and vignette
# @duration 29
# bonechurch.dmt - a gothic cathedral built from fractal bone and stained glass
# 110 BPM, ~28 seconds, 13 bars of dark rave mass.

title BONECHURCH
song bpm=110 speed=6 rpb=4 channels=6 loop=1 volume=0.60
order 0 1 2 3 4 5 6 7 3 5 8 6 9
pan 0.5 0.5 0.5 0.4 0.6 0.5

# ------------------------------------------------------------------ palettes
text word "BONECHURCH"

palette bone {
  0.00  0.100 0.110 0.130
  0.25  0.220 0.230 0.250
  0.50  0.420 0.430 0.450
  0.75  0.680 0.690 0.700
  1.00  0.950 0.950 0.940
}

palette glass {
  0.00  0.150 0.000 0.250
  0.11  0.500 0.000 0.550
  0.22  0.950 0.000 0.300
  0.33  1.000 0.550 0.000
  0.44  0.000 0.600 1.000
  0.55  0.000 0.950 1.000
  0.66  1.000 1.000 0.000
  0.77  1.000 0.250 0.250
  0.88  0.700 0.000 0.900
  1.00  0.150 0.000 0.250
}

palette ember {
  0.00  0.050 0.010 0.000
  0.30  0.600 0.150 0.020
  0.60  1.000 0.450 0.050
  0.85  1.000 0.900 0.250
  1.00  1.000 1.000 0.700
}

# ------------------------------------------------------------------ instruments
inst kick {
  f = 50 + 420 * exp(-t * 42)
  $p = $p + f / sr
  body = sin($p * tau) * exp(-t * 7)
  click = noise() * exp(-t * 90) * 0.6
  out(dist((body + click) * 2.2, 1.45) * 0.72)
}

inst snare {
  n = hp(noise(), 2200) * exp(-t * 15)
  tone = sin(tau * 210 * t) * exp(-t * 38)
  out((n * 0.8 + tone * 0.55) * 0.55)
}

inst hat {
  n = hp(noise(), 6500)
  out(n * exp(-t * 75) * 0.32)
}

inst organ {
  e = env(0.04, 0.35, 0.75, 0.35)
  a = saw(ph) + saw(ph * 0.997) * 0.5 + saw(ph * 1.004) * 0.3
  a = lp(a, 700 + 1800 * e)
  out(a * e * 0.22)
}

inst choir {
  e = env(0.25, 0.55, 0.7, 0.75)
  vib = 1 + 0.012 * sin(t * 4.5)
  $p = $p + freq * vib / sr
  a = saw($p) + saw($p * 1.003) * 0.55 + saw($p * 0.996) * 0.45
  a = svf(a, 900 + 600 * sin(t * 0.4), 0.35)
  out(a * e * 0.16)
}

inst bell {
  e = exp(-t * 2.2)
  m = sin(ph * tau * 2.3) * 2.8 * exp(-t * 2.8)
  a = sin(ph * tau + m)
  b = sin(ph * tau * 3.4 + m * 0.4)
  out((a * 0.7 + b * 0.3) * e * 0.26)
}

# ------------------------------------------------------------------ master
master {
  dl = dly(l, 0.273, 0.34)
  dr = dly(r, 0.409, 0.34)
  w = verb(l * 0.5 + r * 0.5, 0.82, 0.5)
  out(dist(l + dr * 0.24 + w * 0.16, 1.2), dist(r + dl * 0.24 + w * 0.16, 1.2))
}

