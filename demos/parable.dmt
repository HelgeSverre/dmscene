# ------------------------------------------------------------------ helpers
fn textline(s, px, py, sz) {
  cx = (u - px) / sz
  cy = (py - v) / sz
  i = floor(cx)
  return glyph(str(s, i), fract(cx), fract(cy)) * step(0, cx) * step(cx, strlen(s)) * step(0, cy) * step(cy, 1)
}
fn crawl(s, base, sz, spd) {
  per = strlen(s) * sz
  px = aspect - fract(time * spd / per) * per
  cx = (u - px) / sz
  i = floor(cx)
  cy = (base - v) / sz
  g = glyph(str(s, i), fract(cx), fract(cy)) * step(0, cx) * step(cx, strlen(s)) * step(0, cy) * step(cy, 1)
  cx2 = (u - px - per) / sz
  i2 = floor(cx2)
  cy2 = (base - v) / sz
  g2 = glyph(str(s, i2), fract(cx2), fract(cy2)) * step(0, cx2) * step(cx2, strlen(s)) * step(0, cy2) * step(cy2, 1)
  return max(g, g2)
}

# ------------------------------------------------------------------ visuals
uniform phase rayN kickE bellE seedE padE warm intro breathe

frame {
  rayN = evtl(rays)
  kickE = exp(-trig(0) * 7)
  bellE = exp(-trig(4) * 5)
  seedE = exp(-trig(1) * 14)
  padE = cenv(3)
  phase = lbeat / llen
  warm = smooth(0.58, 0.92, phase)
  intro = 1 - smooth(0.0, 0.10, phase)
  breathe = 0.90 + 0.10 * sin(beat * 0.32)
}

pixel {
  f = 0.6
  fy = -0.15
  fdx = len(u, v - fy)

  # Sky: indigo at the top, warm near the ground and around the focus.
  ky = v * 0.5 + 0.5
  tone = 0.04 + 0.30 * (1 - ky) + 0.22 * exp(-fdx * fdx * 2.4) + 0.03 * sin(time * 0.13)
  tone = tone + 0.20 * padE * exp(-fdx * fdx * 1.2)
  pal(dusk, tone)
  mixpal(ember, tone + 0.18, warm * 0.85)

  # The mirror itself: a parabola v = fy + u^2/(4f) opening upward.
  ymir = fy + u * u / (4 * f)
  dish = step(abs(u), 1.5) * step(fy, v) * exp(-((v - ymir) * (v - ymir)) / 0.00045)

  # The focus point, burning with the music.
  focus = exp(-fdx * fdx / 0.0011) * (0.35 + 2.0 * kickE + 1.4 * bellE + 0.5 * seedE)

  lum = max(dish * 0.55, focus)

  # Rays: pairs appear symmetric around the axis, walking outward as rayN grows.
  repeat i 12 {
    wt = clamp(rayN - i, 0, 1)
    half = floor((i + 1) / 2)
    side = 1 - 2 * (i % 2)
    xr = side * (0.22 + 0.19 * half)
    ym = fy + xr * xr / (4 * f)
    di = abs(u - xr)
    above = step(ym, v) * step(v, 1.0)
    segIn = above * exp(-(di * di) / 0.0004)
    sx = 0 - xr
    syy = fy - ym
    l2 = sx * sx + syy * syy
    tt = clamp(((u - xr) * sx + (v - ym) * syy) / l2, 0, 1)
    pxx = xr + tt * sx
    pyy = ym + tt * syy
    dr = len(u - pxx, v - pyy)
    segRefl = exp(-(dr * dr) / 0.00062) * (0.22 + 1.85 * (1 - tt))
    lum = max(lum, wt * (segIn * 0.22 + segRefl))
  }

  # The return path: an expanding ring that speaks on the beat near the end.
  ringR = 0.12 + 0.55 * phase
  ring = exp(-abs(fdx - ringR) * 18) * warm * (0.25 + 0.9 * kickE)
  lum = lum + ring

  # Colour the gathered light: warm core with a cool violet halo.
  cadd(lum, lum * 0.76, lum * 0.40)
  cadd(lum * 0.12, lum * 0.20, lum * 0.34)

  # The word and the moral.
  tg = textline(title, 0.0, 0.66, 0.46) * intro
  cadd(tg * 0.9, tg * 0.82, tg * 0.62)
  sg = crawl(scroll, -0.80, 0.13, 0.7) * 0.45
  cadd(sg * 0.5, sg * 0.65, sg * 0.8)

  # A converging afterimage: the previous frame crawls toward the focus.
  xf = 0.5
  yf = 0.5 + fy / 2
  sx0 = xf + (x - xf) * 0.986
  sy0 = yf + (y - yf) * 0.986
  cprev(sx0, sy0, 0.62 * (0.55 + 0.45 * warm))

  rr = len(u, v)
  cmul((1 - 0.30 * rr * rr) * breathe)
}
