# @model DeepSeek V4 Pro
# @collection Written by the models
# @music ambient: heartbeat kick, seed-noise ticks, FM sub bass, breathing SVF pad, FM bell arp through cross-fed delay and reverb
# @visual a parabolic mirror gathers parallel rays into a burning focus; pure Euclidean geometry, timeline-ramped rays, dusk-to-ember palette, converging feedback, a crawling moral line
# @duration 30
# parable.dmt - one mirror, many paths, one light.
# A contemplative geometry demo: a parabolic dish gathers parallel rays into a
# single burning focus. The rays arrive one pair at a time across a twelve-bar
# arc, the sky turns from indigo dusk to ember, an expanding ring speaks the
# return path, and the word PARABLE hangs above while a one-line moral crawls
# underneath. Everything is pixel-space geometry (a real parabola + reflected
# rays), palette-mapped, with a converging afterimage in the feedback buffer.

title PARABLE
song bpm=96 speed=6 rpb=4 channels=5 loop=0 volume=0.62 dither=1
order 0 1 1 2 3 2 4 1 2 3 5 5
pan 0.42 0.58 0.50 0.46 0.62

text title "PARABLE"
text scroll "  MANY PATHS ...  ONE LIGHT ...  EVERY PARABLE GATHERS ITS DUST TO A SINGLE POINT ...  ALL THE WANDERERS MEET AT THE FIRE ...  "

palette dusk {
  0.00  0.012 0.010 0.070
  0.30  0.075 0.055 0.220
  0.55  0.320 0.160 0.330
  0.72  0.760 0.340 0.300
  0.86  0.990 0.660 0.330
  0.96  1.000 0.940 0.760
  1.00  0.012 0.010 0.070
}
palette ember {
  0.00  0.028 0.006 0.012
  0.30  0.320 0.045 0.030
  0.55  0.720 0.150 0.060
  0.75  0.990 0.350 0.090
  0.90  1.000 0.820 0.420
  1.00  0.028 0.006 0.012
}

timeline {
  0:00 rays=2.0
  1:00 rays=3.2
  2:00 rays=4.4
  3:00 rays=5.6
  4:00 rays=6.8
  5:00 rays=8.0
  6:00 rays=9.2
  7:00 rays=10.4
  8:00 rays=11.0
  9:00 rays=12.0
  10:00 rays=12.0
  11:00 rays=12.0
}

# ------------------------------------------------------------------ instruments
inst heart {
  f = 46 + 300 * exp(-t * 36)
  $p = $p + f / sr
  thump = sin($p * tau) * exp(-t * 7)
  air = lp(noise(), 900) * exp(-t * 40)
  out(dist(thump * 1.8 + air * 0.10, 1.4) * 0.55)
}
inst seed {
  n = hp(noise(), 7400)
  out(n * exp(-t * (34 + 60 * (1 - vel))) * 0.16)
}
inst root {
  e = env(0.012, 0.28, 0.55, 0.30)
  sub = sin(ph * tau)
  wood = svf(tri(ph) * 0.9 + saw(ph) * 0.22, 150 + 500 * e, 0.28)
  out((sub * 0.55 + wood * 0.20) * e * 0.5)
}
inst pad {
  e = env(0.5, 0.8, 0.72, 1.0)
  a = sin(ph * tau + 0.6 * sin(ph * tau * 0.5 + t * 0.22))
  b = saw(ph + 0.0016 * t) + saw(ph - 0.0021 * t)
  s = svf(a * 0.7 + b * 0.24, 420 + 260 * sin(t * 0.27) + p0 * 700, 0.20)
  out(s * e * 0.22)
}
inst bell {
  e = exp(-t * 2.1)
  m = sin(ph * tau * 2.05) * exp(-t * 3.2) * 1.6
  s = sin(ph * tau + m) + sin(ph * tau * 2.01 + m * 0.35) * 0.30
  out(s * e * 0.24)
}

master {
  dl = dly(l, 0.46875, 0.38)
  dr = dly(r, 0.625, 0.34)
  vl = verb(l + dr * 0.24, 0.72, 0.50)
  vr = verb(r + dl * 0.24, 0.72, 0.50)
  out(dist(l + dr * 0.26 + vl * 0.20, 1.15), dist(r + dl * 0.26 + vr * 0.20, 1.15))
}

