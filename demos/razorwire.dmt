# @model Kimi K2.7 Code
# @collection Written by the models
# @music industrial hard techno: distorted kick, metallic hats and snare, FM bass, stab lead, drone pad, noise texture; master delay/reverb/saturation
# @visual sharp rotating KIFS blades folded through a kaleidoscope mirror with Kali filaments, snare-triggered RGB glitch, low-persistence feedback trails, bloom, scanlines and vignette
# @duration 27
# razorwire.dmt - industrial hard techno with sharp KIFS geometry and feedback trails
# 165 BPM, ~26 seconds, 9 patterns of 32 rows.

title RAZORWIRE
song bpm=165 speed=6 rpb=4 channels=6 loop=8 volume=0.60
order 0 1 2 3 4 5 6 7 8
pan 0.5 0.55 0.5 0.45 0.6 0.4

palette steel {
  0.00 0.010 0.015 0.030
  0.12 0.040 0.080 0.140
  0.28 0.200 0.420 0.650
  0.42 0.750 0.850 0.920
  0.55 0.950 0.700 0.120
  0.68 0.920 0.250 0.060
  0.82 0.550 0.100 0.050
  1.00 0.010 0.015 0.030
}

# ------------------------------------------------------------------ instruments
inst kick {
  f = 42 + 680 * exp(-t * 55)
  $p = $p + f / sr
  body = sin($p * tau) * exp(-t * 7.5)
  click = hp(noise(), 3500) * exp(-t * 100) * 0.55
  out(dist((body + click) * 2.6, 1.9) * 0.72)
}

inst snare {
  n = hp(noise(), 2800) * exp(-t * 17)
  tone = sin(tau * 215 * t) * exp(-t * 30)
  out((n * 0.9 + tone * 0.5) * 0.62)
}

inst hat {
  n = hp(noise(), 9500)
  d = 50 + 90 * (1 - vel)
  out(n * exp(-t * d) * 0.34)
}

inst bass {
  e = env(0.002, 0.14, 0.38, 0.10)
  s = saw(ph) * 0.65 + sqr(ph * 0.5, 0.4) * 0.35
  s = svf(s, 100 + 2600 * e * (0.45 + p0), 0.32)
  out(dist(s * 1.5, 1.7) * e * 0.58)
}

inst lead {
  e = env(0.001, 0.09, 0.15, 0.16)
  m = sin(ph * tau * 2.2) * 1.7 * e
  s = sin(ph * tau + m) + saw(ph * 1.01) * 0.4
  s = svf(s, 900 + 5500 * e, 0.22)
  out(dist(s, 1.5) * e * 0.32)
}

inst pad {
  e = env(0.20, 0.9, 0.60, 1.1)
  a = sin(ph * tau + 0.6 * sin(ph * tau * 0.5 + t * 0.35))
  b = saw(ph + t * 0.0015) * 0.5 + saw(ph - t * 0.0019) * 0.5
  s = svf(a + b * 0.5, 400 + 800 * e, 0.18)
  out(s * e * 0.20)
}

inst noise {
  e = exp(-t * (6 + p1 * 18))
  s = svf(noise(), 800 + p0 * 7000, 0.45)
  out(s * e * 0.28)
}

# ------------------------------------------------------------------ master
master {
  dl = dly(l, 0.227, 0.40)
  dr = dly(r, 0.341, 0.40)
  vl = verb(l * 0.5 + r * 0.5, 0.62, 0.52)
  out(dist(l + dr * 0.28 + vl * 0.16, 1.25), dist(r + dl * 0.28 + vl * 0.16, 1.25))
}

