  .        | C-6 3 10 | .        | .        | .        | C-4 7 12
  .        | .        | .        | .        | .        | .
  C-2 1 20 | D-5 2 18 | .        | .        | .        | .
  .        | .        | .        | .        | .        | .
  .        | C-6 3 10 | A-1 4 18 | .        | .        | C-4 7 10
  .        | .        | .        | .        | .        | .
}

# ------------------------------------------------------------------ visuals
uniform kickE snE leadE rot zoom blade fold glow glitch

frame {
  kickE = exp(-trig(0) * 14)
  snE = exp(-trig(1) * 16) * step(0.5, vel(1))
  leadE = exp(-trig(3) * 10)
  rot = beat * 0.095 + 0.25 * sin(beat * 0.06)
  zoom = 1.05 + 0.18 * kickE + 0.04 * sin(beat * 0.33)
  blade = 0.5 + 0.5 * sin(lbeat * 0.09)
  fold = 4 + floor(4 * (0.5 + 0.5 * sin(beat * 0.03125)))
  glow = 0.5 + 0.5 * sin(beat * 0.125)
  glitch = step(0.72, hash(floor(beat * 4) * 17.3))
}

pixel {
  # aspect-corrected rotation
  px = rot(u, v, rot)
  py = r1

  # kaleidoscope fold into sharp sectors
  sector = tau / fold
  a = atan2(py, px)
  r = len(px, py)
  ma = abs(fract(a / sector + 0.5) - 0.5) * sector
  px = cos(ma) * r
  py = sin(ma) * r

  # KIFS fractal: sharp, metallic blades
  k = kifs(px * 1.35 * zoom, py * 1.35 * zoom, 1.62 + 0.06 * blade, beat * 0.025, 9)
  trap = r1
  fx = r2
  fy = r3

  # secondary Kali layer for extra filaments
  kk = kali(px * 2.1 * zoom, py * 2.1 * zoom, 0.72 + 0.06 * blade, 0.78, 7)
  kmean = r1

  # wireframe edge from distance estimate
  edge = exp(-k * 9)
  filament = exp(-kk * 6)

  # palette sweep
  tone = k * 0.13 + trap * 0.22 + kmean * 0.08 + beat * 0.018
  pal(steel, tone)

  # light: hot core on edges, cool filaments, plus a slow breathing ambient glow
  breathe = 0.5 + 0.5 * sin(beat * 0.25)
  light = 0.22 + edge * 1.6 + filament * 0.55 + leadE * 0.3 + breathe * 0.18
  cmul(light)

  # kick flash in warm channel
  cadd(kickE * 0.12, kickE * 0.03, kickE * 0.01)

  # snare-driven RGB split / glitch
  gx = x + snE * glitch * 0.04 * (hash(y * 137.7) - 0.5)
  gy = y + snE * glitch * 0.03 * (hash(x * 93.3) - 0.5)
  fbZoom = 0.995 + 0.01 * sin(beat * 0.25) + kickE * 0.012
  fbRot = 0.004 * sin(beat * 0.125)
  cprevz(gx, gy, fbZoom, fbRot, 0.50)

  # vignette
  d = len(u, v)
  cmul(1 - 0.38 * d * d)
}

post {
  # bloom cross
  b = tap(-1, 0) + tap(1, 0) + tap(0, -1) + tap(0, 1)
  bl = b * 0.25
  rgb(cget(0) + bl * 0.22, cget(1) + bl * 0.18, cget(2) + bl * 0.20)

  # scanlines
  cmul(1 - 0.12 * step(0.5, fract(y * h * 0.5)))

  # strong vignette
  d = len(u, v)
  cmul(1 - 0.38 * d * d)
}
