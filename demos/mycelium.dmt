# @collection Demos
# @music ambient: heartbeat kick, spores, root bass, breath pad, glints, rustle and wind
# @visual a warped plane folded into mushroom-gill radials, branching filaments, a cellular spore layer and breathing colour feedback over a 64-beat arc
# mycelium.dmt - psilocybin-inspired breathing gills, spores, and iridescent mycelium
# A 64-beat journey: emergence, branching, bloom, and a quiet return.
title MYCELIUM
song bpm=92 speed=6 rpb=4 channels=6 loop=0 volume=0.54
order 0 0 1 1 2 2 3 3 0 1 2 3 1 2 3 0

palette night {
  0.00 0.005 0.010 0.030
  0.18 0.025 0.060 0.120
  0.36 0.110 0.040 0.220
  0.54 0.200 0.480 0.500
  0.72 0.850 0.380 0.480
  0.88 0.980 0.780 0.490
  1.00 0.005 0.010 0.030
}
palette bloom {
  0.00 0.025 0.010 0.080
  0.18 0.180 0.035 0.280
  0.36 0.630 0.100 0.430
  0.54 0.970 0.400 0.520
  0.72 0.970 0.830 0.480
  0.88 0.340 0.900 0.770
  1.00 0.025 0.010 0.080
}

inst heart {
  f = 48 + 370 * exp(-t * 35)
  $phase = $phase + f / sr
  thump = sin($phase * tau) * exp(-t * 7)
  air = lp(noise(), 900) * exp(-t * 45)
  out(dist(thump * 1.6 + air * 0.12, 1.3) * 0.60)
}
inst spores {
  n = hp(noise(), 6500)
  out(n * exp(-t * (24 + 55 * (1 - vel))) * 0.22)
}
inst root {
  e = env(0.015, 0.30, 0.55, 0.35)
  sub = sin(ph * tau)
  wood = svf(tri(ph) + saw(ph * 2.003) * 0.24, 130 + 420 * e, 0.25)
  out((sub * 0.46 + wood * 0.20) * e)
}
inst breath {
  e = env(0.40, 0.8, 0.75, 1.3)
  a = sin(ph * tau + sin(ph * tau * 0.5 + t * 0.27) * 0.7)
  b = saw(ph + t * 0.0013) + saw(ph - t * 0.0017)
  s = svf(a * 0.7 + b * 0.22, 450 + 220 * sin(t * 0.31) + p0 * 800, 0.2)
  out(s * e * 0.25)
}
inst glint {
  e = exp(-t * 1.9)
  mod = sin(ph * tau * 2.51) * 1.7 * exp(-t * 2.8)
  a = sin(ph * tau + mod)
  b = sin(ph * tau * 2.01 + mod * 0.3)
  out((a + b * 0.32) * e * 0.24)
}
inst rustle {
  n = svf(noise(), 1700 + 1500 * exp(-t * 12), 0.4)
  out((n * 0.7 + r2 * 0.5) * exp(-t * 8) * 0.32)
}
inst wind {
  e = env(0.7, 0.7, 0.6, 1.2)
  n = svf(noise(), 650 + 500 * sin(t * 0.24), 0.3)
  out(n * e * 0.10)
}

master {
  dl = dly(l, 0.489, 0.42)
  dr = dly(r, 0.652, 0.42)
  vl = verb(l + dr * 0.26, 0.77, 0.55)
  vr = verb(r + dl * 0.26, 0.77, 0.55)
  out(dist(l + dr * 0.32 + vl * 0.20, 1.15), dist(r + dl * 0.32 + vr * 0.20, 1.15))
}

# channels: 0 heartbeat, 1 spores, 2 root bass, 3 breath pad, 4 glints, 5 rustle/wind
pattern 0 rows=16 {
  C-2 1 32 | .        | A-1 3 34 | A-3 4 27 S30 | .        | A-4 7 22
  .        | .        | .        | .            | .        | .
  .        | C-6 2 10 | .        | .            | E-5 5 17 | .
  .        | .        | .        | .            | .        | .
  .        | .        | .        | .            | .        | .
  .        | C-6 2 14 | .        | .            | .        | .
  .        | .        | E-2 3 27 | .            | A-5 5 14 | .
  .        | .        | .        | .            | .        | .
  C-2 1 28 | .        | F-1 3 34 | F-3 4 26 S55 | .        | .
  .        | .        | .        | .            | .        | .
  .        | C-6 2 11 | .        | .            | C-6 5 18 | .
  .        | .        | .        | .            | .        | .
  .        | .        | .        | .            | .        | .
  .        | C-6 2 14 | C-2 3 25 | .            | .        | .
  .        | .        | .        | .            | A-5 5 15 | .
  .        | .        | .        | .            | .        | .
}
pattern 1 rows=16 {
  C-2 1 36 | .        | D-1 3 36 | D-3 4 29 S70 | A-4 5 21 | C-4 6 22
  .        | C-6 2 11 | .        | .            | .        | .
  .        | C-6 2 17 | .        | .            | F-5 5 19 | .
  .        | .        | A-1 3 25 | .            | .        | .
  .        | .        | .        | .            | C-6 5 17 | C-4 6 18
  .        | C-6 2 12 | .        | .            | .        | .
  .        | C-6 2 19 | D-2 3 28 | .            | A-5 5 20 | .
  .        | .        | .        | .            | .        | .
  C-2 1 36 | .        | G-1 3 36 | G-3 4 29 S95 | .        | C-4 6 24
  .        | C-6 2 11 | .        | .            | .        | .
  .        | C-6 2 17 | .        | .            | D-6 5 19 | .
  .        | .        | D-2 3 25 | .            | .        | .
  .        | .        | .        | .            | B-5 5 17 | C-4 6 18
  .        | C-6 2 12 | .        | .            | .        | .
  .        | C-6 2 19 | G-2 3 28 | .            | G-5 5 20 | .
  .        | .        | .        | .            | D-5 5 13 | .
}
pattern 2 rows=16 {
  C-2 1 39 | C-6 2 10 | A-1 3 38 | A-3 4 31 SC0 | C-5 5 22 | C-4 6 25
  .        | .        | .        | .            | .        | .
  .        | C-6 2 19 | E-2 3 29 | .            | E-5 5 19 | .
  .        | .        | .        | .            | G-5 5 15 | .
  .        | C-6 2 12 | .        | .            | A-5 5 22 | C-4 6 19
  .        | .        | .        | .            | .        | .
  .        | C-6 2 21 | E-2 3 29 | .            | C-6 5 20 | .
  .        | .        | .        | .            | E-6 5 15 | .
  C-2 1 39 | C-6 2 10 | F-1 3 38 | F-3 4 31 SE0 | A-4 5 22 | C-4 6 25
  .        | .        | .        | .            | .        | .
  .        | C-6 2 19 | C-2 3 29 | .            | C-5 5 19 | .
  .        | .        | .        | .            | E-5 5 15 | .
  .        | C-6 2 12 | .        | .            | F-5 5 22 | C-4 6 19
  .        | .        | .        | .            | .        | .
  .        | C-6 2 21 | C-2 3 29 | .            | A-5 5 20 | .
  .        | .        | .        | .            | C-6 5 15 | .
}
pattern 3 rows=16 {
  C-2 1 31 | .        | E-1 3 32 | E-3 4 27 S50 | B-4 5 20 | E-4 7 20
  .        | .        | .        | .            | .        | .
  .        | C-6 2 11 | .        | .            | G-5 5 17 | .
  .        | .        | .        | .            | .        | .
  .        | .        | B-1 3 25 | .            | E-5 5 15 | .
  .        | C-6 2 13 | .        | .            | .        | .
  .        | .        | .        | .            | B-5 5 17 | .
  .        | .        | .        | .            | .        | .
  C-2 1 29 | .        | G-1 3 33 | G-3 4 27 S35 | D-5 5 19 | .
  .        | .        | .        | .            | .        | .
  .        | C-6 2 11 | .        | .            | B-4 5 16 | .
  .        | .        | .        | .            | .        | .
  .        | .        | D-2 3 25 | .            | G-5 5 16 | .
  .        | C-6 2 13 | .        | .            | .        | .
  .        | .        | .        | .            | D-5 5 14 | .
  .        | .        | .        | .            | .        | .
}

uniform spin swell hue pulse glint bloomAmt breathAmp phase fold
frame {
  phase = lbeat / llen
  pulse = exp(-trig(0) * 5)
  glint = exp(-trig(4) * 3.8)
  breathAmp = 0.5 + 0.5 * sin(beat * 0.25 * pi - 0.5)
  bloomAmt = smooth(0.14, 0.43, phase) * (1 - smooth(0.76, 1.0, phase))
  swell = 0.75 + 0.23 * breathAmp + 0.07 * pulse
  spin = beat * 0.028 + 0.18 * sin(beat * 0.06)
  hue = beat * 0.006 + glint * 0.018
  fold = 6 + floor(bloomAmt * 4)
}

pixel {
  # Fold a slowly warped plane into the radial structure of mushroom gills.
  warp = fbm(u * 1.7 + beat * 0.012, v * 1.7 - beat * 0.009, 3)
  wx = u + 0.13 * (warp - 0.5) * (0.4 + bloomAmt)
  wy = v + 0.10 * sin(u * 5 + beat * 0.045) * (warp - 0.25)
  radius = polar(wx, wy)
  angle = r1 + spin + 0.18 * sin(radius * 7 - beat * 0.09)
  sector = tau / fold
  mirrored = abs(fract(angle / sector + 0.5) - 0.5) * sector
  p = radius * swell
  gx = cos(mirrored) * p
  gy = sin(mirrored) * p

  # Branching filaments and cap ribs, with concentric waves from the heart.
  branch = kali(gx * 0.85, gy * 0.85, 0.76, 0.79, 6)
  orbit = r1
  vein = exp(-branch * 17)
  ribs = exp(-abs(sin(mirrored * fold * 3 + p * 9 - beat * 0.065)) * (4 + 3 * p))
  rings = exp(-abs(sin(p * 20 - beat * 0.31)) * 7)
  cap = 1 - smooth(0.57, 0.85, p)
  centre = exp(-p * 6)
  edge = exp(-abs(p - (0.53 + 0.025 * sin(mirrored * fold * 3 + beat * 0.08))) * 22)

  # Fine drifting spores sit above the gills in their own cellular field.
  cell = vor(wx * 8 + beat * 0.018, wy * 8 - beat * 0.014)
  cellid = r1
  sporesGlow = exp(-cell * 24) * (0.24 + 0.55 * glint)
  mist = fbm(wx * 3.3 - beat * 0.014, wy * 3.3 + beat * 0.011, 3)

  tone = orbit * 0.32 + p * 0.29 + hue + mist * 0.12
  pal(night, tone)
  mixpal(bloom, tone + 0.10, bloomAmt * 0.82)
  light = 0.10 + cap * (vein * 0.90 + ribs * 0.48 + rings * 0.18 + edge * 0.72)
  light = light + sporesGlow * (0.35 + 0.65 * bloomAmt) + centre * (0.18 + pulse * 0.40)
  cmul(light * (1.15 + 0.55 * breathAmp))
  cadd(edge * (0.07 + bloomAmt * 0.15), sporesGlow * 0.07, vein * glint * 0.10)

  # Persistent colour smears outward, like an afterimage breathing with the beat.
  sx = 0.5 + (x - 0.5) * (0.987 + pulse * 0.014)
  sy = 0.5 + (y - 0.5) * (0.987 + pulse * 0.014)
  cprev(sx, sy, 0.30 + bloomAmt * 0.14)
  cmul(1 - 0.22 * radius * radius)
}
