# ------------------------------------------------------------------ helpers
fn textline(s, px, py, sz) {
  cx = (u - px) / sz
  cy = (py - v) / sz
  i = floor(cx)
  return glyph(str(s, i), fract(cx), fract(cy)) * step(0, cx) * step(cx, strlen(s)) * step(0, cy) * step(cy, 1)
}
fn scroller(s, py, sz, speed) {
  # endless wrap: the text repeats after strlen + 12 cells
  per = (strlen(s) + 12) * sz
  px = 1.7 * aspect - fract(time * speed / per) * per
  a = textline(s, px, py, sz)
  b = textline(s, px + per, py, sz)
  return max(a, b)
}
fn torus(px, py, pz, R, rr) {
  q = len(px, pz) - R
  return len(q, py) - rr
}
fn scenesdf(px, py, pz, tw) {
  # twisted torus: rotate xz by y
  a = py * tw
  rx = rot(px, pz, a)
  rz = r1
  return torus(rx, py, rz, 1.0, 0.38 + 0.08 * kickE)
}

uniform kickE snE padE plE camx camy camz twistk fogk

frame {
  kickE = exp(-trig(0) * 9)
  snE = exp(-trig(1) * 8) * step(0.5, vel(1))
  padE = cenv(3)
  plE = exp(-trig(4) * 7)
  select(evt(scene))
  cam = evtl(cam)
  twistk = evtl(twist) * (1 + 0.2 * sin(beat * 0.5))
  fogk = evtl(fog)
  camx = 3.2 * sin(beat * 0.1 + cam)
  camz = 3.2 * cos(beat * 0.1 + cam)
  camy = 1.2 * sin(beat * 0.07) + 0.3 * cam
}

pixel intro {
  # plasma background, big title, scroller
  p1 = sin(u * 3 + beat * 0.5) + sin(v * 4 - beat * 0.3) + sin((u + v) * 2.5 + beat * 0.2)
  pal(sky, p1 * 0.12 + 0.5 + bar * 0.02)
  cmul(0.25 + 0.2 * kickE)
  g = evtl(glow)
  ttl = textline(title, -1.05, 0.45, 0.3)
  halo = 0
  repeat k 5 {
    halo = halo + textline(title, -1.05 + (k - 2) * 0.012, 0.45 + (k - 2) * 0.008, 0.3)
  }
  cadd(ttl * 1.0 + halo * 0.12 * g, ttl * 0.85 + halo * 0.06 * g, ttl * 0.5 + halo * 0.15 * g)
  sc = scroller(scroll, -0.55, 0.11, 1.2)
  cadd(sc * 0.9, sc, sc)
  cprevz(0.5, 0.42, 1.01, 0.0, 0.3 * g)
}

pixel march {
  # raymarched twisted torus
  ro_x = camx
  ro_y = camy
  ro_z = camz
  # look at the origin: build a camera basis
  fl = len(len(ro_x, ro_z), ro_y)
  fx = -ro_x / fl
  fy = -ro_y / fl
  fz = -ro_z / fl
  rl = len(fz, fx) + 0.0001
  rxx = fz / rl
  rxz = -fx / rl
  upx = fy * rxz
  upy = fz * rxx - fx * rxz
  upz = -fy * rxx
  dx = fx * 1.6 + rxx * u + upx * v
  dy = fy * 1.6 + upy * v
  dz = fz * 1.6 + rxz * u + upz * v
  dl = len(len(dx, dz), dy)
  dx = dx / dl
  dy = dy / dl
  dz = dz / dl
  tt = 0
  d = 1
  repeat i 36 {
    px = ro_x + dx * tt
    py = ro_y + dy * tt
    pz = ro_z + dz * tt
    d = scenesdf(px, py, pz, twistk)
    tt = tt + d * 0.85 * step(0.002, d)
  }
  hit = step(d, 0.02) * step(tt, 12)
  px = ro_x + dx * tt
  py = ro_y + dy * tt
  pz = ro_z + dz * tt
  e = 0.01
  nx = scenesdf(px + e, py, pz, twistk) - scenesdf(px - e, py, pz, twistk)
  ny = scenesdf(px, py + e, pz, twistk) - scenesdf(px, py - e, pz, twistk)
  nz = scenesdf(px, py, pz + e, twistk) - scenesdf(px, py, pz - e, twistk)
  nl = len(len(nx, nz), ny) + 0.0001
  nx = nx / nl
  ny = ny / nl
  nz = nz / nl
  lx = 0.5
  ly = 0.8
  lz = -0.3
  diff = max(nx * lx + ny * ly + nz * lz, 0)
  rim = (1 - max(-(nx * dx + ny * dy + nz * dz), 0)) ^ 3
  band = 0.5 + 0.5 * sin(atan2(pz, px) * 6 + py * 10 - beat * 2)
  pal(sky, 0.15 + band * 0.25 + tt * 0.03 + bar * 0.01)
  cmul(hit * (0.15 + 0.9 * diff + 0.8 * rim * evtl(glow)) * exp(-tt * 0.08 * fogk))
  # background: dark gradient with stars on the snare
  bg = (1 - hit) * (0.02 + 0.05 * (v + 1))
  st = (1 - hit) * step(0.997, hash(floor(u * 120) + floor(v * 120) * 77.7)) * (0.3 + snE)
  cadd(bg * 0.4 + st, bg * 0.2 + st, bg + st)
  cmul(1 + 0.3 * kickE)
}

pixel feedback {
  # spiral feedback with the pluck drawing rings
  rr = len(u, v)
  ring = exp(-abs(rr - 0.3 - 0.4 * fract(beat * 0.5)) * 30) * plE
  pal(sky, rr * 0.5 + bar * 0.05)
  cmul(ring * 1.5 + kickE * 0.1 * exp(-rr * 3))
  sc = scroller(scroll, 0.7, 0.09, 0.9)
  cadd(sc, sc * 0.9, sc * 0.6)
  cprevz(0.5, 0.5, 1.04, 0.03 + 0.03 * padE, 0.92)
}

pixel end {
  pal(sky, 0.55 + 0.1 * sin(u * 2 + beat * 0.2))
  cmul(0.12 + 0.15 * kickE)
  ttl = textline(title, -1.05, 0.5, 0.3)
  cadd(ttl, ttl * 0.9, ttl * 0.7)
  cr = scroller(credits, -0.3, 0.12, 0.8)
  cadd(cr * 0.9, cr, cr)
  cprevz(0.5, 0.5, 1.0, 0.0, 0.5 * evtl(glow))
}

post {
  # bloom-ish: average a cross of taps, add on top; chromatic shift on red; vignette; scanlines
  g = evtl(glow)
  b = tap(-2, 0) + tap(2, 0) + tap(0, -2) + tap(0, 2) + tap(-1, -1) + tap(1, 1) + tap(-1, 1) + tap(1, -1)
  bl = b * 0.125
  rsh = tap(-2 - floor(3 * kickE), 0)
  cr = mix(cget(0), rsh, 0.5)
  rgb(cr + bl * 0.35 * g, cget(1) + bl * 0.3 * g, cget(2) + bl * 0.4 * g)
  d = len(u, v)
  cmul(1 - 0.35 * d * d)
  cmul(1 - 0.18 * step(0.5, fract(y * h * 0.5)))
}
