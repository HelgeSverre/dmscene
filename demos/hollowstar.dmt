# ------------------------------------------------------------------ visuals
uniform kickE snE bellE arpE holeR spinK lensK shx shy

frame {
  select(evt(scene))
  kickE = exp(-trig(0) * 8)
  snE = exp(-trig(1) * 9) * step(0.5, vel(1))
  bellE = exp(-trig(4) * 2.5)
  arpE = exp(-trig(5) * 9)
  holeR = 0.14 + evtl(die) * 0.32
  spinK = evtl(spin)
  lensK = 0.10 + 0.06 * kickE
  shx = kickE * 0.012 * sin(beat * 41)
  shy = kickE * 0.012 * cos(beat * 37)
}

pixel intro {
  # deep space, a faint ring breathing with the bells, title
  r = polar(u, v) + 0.0001
  a = r1
  warp = 0.06 / (r + 0.18)
  lx = u * (1 + warp)
  ly = v * (1 + warp)
  neb = fbm(lx * 1.6 + 5.1, ly * 1.6 - 2.3, 4)
  pal(void, 0.15 + neb * 0.35)
  cmul(0.45)
  s1 = stars(lx, ly, 22)
  s2 = stars(lx + 3.3, ly - 1.7, 41)
  cadd(s1 * 0.60 + s2 * 0.35, s1 * 0.62 + s2 * 0.36, s1 * 0.75 + s2 * 0.45)
  ring = exp(-abs(r - 0.30) * 60) * (0.10 + 0.35 * bellE + 0.06 * sin(beat * pi))
  cadd(ring * 0.9, ring * 0.55, ring * 0.30)
  ttl = textline(title, -0.70, 0.12, 0.14)
  halo = textline(title, -0.692, 0.112, 0.14)
  fade = smooth(0.4, 2.0, time)
  cadd((ttl + halo * 0.5) * fade * 0.95, (ttl + halo * 0.4) * fade * 0.72, (ttl + halo * 0.3) * fade * 0.42)
  tg = textline(tag, -0.50, -0.14, 0.045) * smooth(1.2, 3.0, time)
  cadd(tg * 0.55, tg * 0.60, tg * 0.72)
  cmul(1 + 0.12 * bellE)
}

pixel star {
  # the hollow star: black disc, photon ring, streaked accretion disc
  sx = u + shx
  sy = v + shy
  rr = polar(sx, sy) + 0.0001
  a = r1

  # gravitationally lensed sky coordinates
  warp = lensK / (rr + 0.10)
  lx = sx * (1 + warp)
  ly = sy * (1 + warp)
  rx2 = rot(lx, ly, beat * 0.01)
  ry2 = r1

  # accretion disc with differential rotation, seam-free noise domain
  discR = 0.30
  dr = rr - discR
  band = exp(-dr * dr * 240)
  streak = fbm(cos(a) * 1.8 + beat * 0.6 / (rr * 4 + 0.4), sin(a) * 1.8 + rr * 9, 5)
  beam = 0.55 + 0.75 * (0.5 + 0.5 * cos(a + 0.7)) ^ 2
  dk = band * (0.35 + 1.1 * streak) * beam
  pal(ember, 0.85 - rr * 1.6 + streak * 0.25)
  cmul(dk * (0.85 + 0.4 * kickE))

  # cold nebula and two star layers behind everything
  neb = fbm(rx2 * 1.5 + 3.7, ry2 * 1.5 - 1.3, 4)
  cadd(neb * neb * 0.10, neb * neb * 0.05, neb * neb * 0.16)
  s1 = stars(rx2, ry2, 22)
  s2 = stars(rx2 + 3.3, ry2 - 1.7, 41)
  cadd(s1 * 0.55 + s2 * 0.30, s1 * 0.58 + s2 * 0.31, s1 * 0.72 + s2 * 0.40)

  # photon ring hugging the hole
  ring = exp(-abs(rr - holeR - 0.035) * 200) * (1.0 + 0.8 * kickE + 0.4 * arpE)
  cadd(ring * 1.25, ring * 1.10, ring * 0.85)

  # the hollow interior: near black with a cold whisper of gas
  cmul(mix(0.03, 1.0, smooth(holeR * 0.72, holeR * 1.04, rr)))
  vd = fbm(cos(a) + beat * 0.05, sin(a) + rr * 3 - beat * 0.08, 4)
  inM = 1 - smooth(holeR * 0.5, holeR * 0.95, rr)
  mixpal(void, vd * 0.7 + beat * 0.01, inM * 0.30)

  # orbiting sparks, some retrograde
  repeat i 9 {
    hi = hash(i * 17.31 + 4.7)
    dir2 = 1 - 2 * step(0.5, hash(i * 5.77 + 0.3))
    ang = hi * tau + beat * (0.20 + 0.45 * hash(i * 3.17)) * dir2 * tau * 0.35
    rad = discR * (0.72 + 0.62 * hash(i * 7.93 + 1.1))
    dx2 = sx - cos(ang) * rad
    dy2 = sy - sin(ang) * rad
    sp2 = exp(-(dx2 * dx2 + dy2 * dy2) * 3200) * (0.30 + 0.70 * (0.5 + 0.5 * sin(beat * 5 + i * 2.1)))
    cadd(sp2 * 1.30, sp2 * 0.85, sp2 * 0.40)
  }

  # kick glow in the core region
  cadd(kickE * 0.10 * exp(-rr * 5), kickE * 0.05 * exp(-rr * 5), kickE * 0.03 * exp(-rr * 5))
  cmul(1 + 0.18 * kickE)
}

pixel collapse {
  # the star falls into itself: shrinking rings + inward spiral feedback
  rr = polar(u, v) + 0.0001
  a = r1
  ph2 = fract(beat * 0.5)
  ringr = mix(0.92, holeR * 1.55 + 0.03, ph2)
  lump = 0.55 + 0.9 * fbm(cos(a) * 2.3 + beat * 0.35, sin(a) * 2.3 - beat * 0.22, 3)
  ring = exp(-abs(rr - ringr) * 22) * (0.30 + 0.9 * kickE) * lump
  ring2 = exp(-abs(rr - mix(0.80, holeR * 1.45, fract(ph2 + 0.5))) * 30) * (0.2 + 0.5 * bellE) * lump
  pal(ember, 0.3 + ph2 * 0.5 + beat * 0.02)
  cmul((ring + ring2 * 0.7) * (0.5 + 0.5 * evtl(glow)))
  st2 = fbm(cos(a) * 2 + rr * 6, sin(a) * 2 - beat * 0.2, 4)
  cadd(st2 * 0.14 * exp(-rr * 1.2), st2 * 0.09 * exp(-rr * 1.2), st2 * 0.20 * exp(-rr * 1.2))
  # sparks spiralling to their death
  repeat i 7 {
    hi = hash(i * 11.17 + 2.9)
    ph3 = fract(beat * (0.25 + 0.3 * hash(i * 3.71)) + hi)
    rad = mix(0.60, holeR * 1.05, ph3)
    ang = hi * tau + ph3 * tau * (1.5 + hash(i * 7.13)) + beat * 0.2
    dx2 = u - cos(ang) * rad
    dy2 = v - sin(ang) * rad
    sp2 = exp(-(dx2 * dx2 + dy2 * dy2) * 2600) * 0.9
    cadd(sp2 * 1.2, sp2 * 0.7, sp2 * 0.35)
  }
  # zoom < 1: the previous frame is pulled toward the hole, with a twist
  cprevz(0.5, 0.5, 0.988 - 0.012 * min(spinK, 2), 0.02 + 0.03 * spinK + 0.03 * snE, 0.86)
  cmul(0.935)
  # the hole eats the light; it grows while the star dies
  cmul(mix(0.0, 1.0, smooth(holeR * 0.85, holeR * 1.25, rr)))
  rim2 = exp(-abs(rr - holeR * 1.18) * 90) * (0.5 + 0.9 * kickE + 0.5 * arpE)
  cadd(rim2 * 1.2, rim2 * 0.55, rim2 * 0.22)
}

post {
  # bloom, radial chromatic aberration, grain, vignette, faint scanlines
  g = evtl(glow)
  b = tap(-3, 0) + tap(3, 0) + tap(0, -2) + tap(0, 2) + tap(-2, -2) + tap(2, 2) + tap(-2, 2) + tap(2, -2)
  bl = b * 0.125
  ca = 1.5 + 3.5 * kickE + 2.0 * snE
  cr = tap(-u * ca, -v * ca)
  cbv = tap(u * ca, v * ca)
  cb = r2
  rgb(mix(cget(0), cr, 0.55) + bl * 0.42 * g, cget(1) + bl * 0.34 * g, mix(cget(2), cb, 0.55) + bl * 0.5 * g)
  gr = (hash(x * 913.7 + y * 771.3 + frame * 0.731) - 0.5) * 0.045
  cadd(gr, gr, gr)
  d = len(u, v)
  cmul(1 - 0.34 * d * d)
  cmul(1 - 0.09 * step(0.5, fract(y * h * 0.5)))
}
