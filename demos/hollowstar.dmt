# @model Kimi K3
# @collection Written by the models
# @music synth sub-kick, sampled snare/hat, sub bass, usaw drone through a channel reverb, inharmonic FM bells, 16th arp in dotted-eighth delay, E9x rolls
# @visual a dying black hole in three timeline-cut scenes: a lensed starfield, a kick-pulsing photon ring, a differentially rotating ember accretion disc with orbiting sparks, then a cprevz infall collapse; bloom, radial chromatic aberration, grain, scanlines
# @duration 28
# hollowstar.dmt - a dying hollow star: black disc, photon ring, streaked
# accretion disc, lensed starfield, orbiting sparks; everything falls inward
# on the collapse scenes. Dark 120 bpm techno: synth kick + sub, sampled
# snare/hat, drone in a hall, FM bells and a dotted-echo arp.
# 14 bars of 16 rows at 120 bpm / speed 6 -> 28 seconds.

title HOLLOWSTAR
song bpm=120 speed=6 rpb=4 channels=6 loop=2 volume=0.52 dither=1
order 0 0 1 2 3 4 2 3 5 6 7 8 9 9
pan 0.5 0.6 0.5 0.42 0.62 0.38

text title "HOLLOWSTAR"
text tag "ALL LIGHT FALLS INWARD"

sample snare "assets/snare.wav"
sample hat "assets/hat.wav"

palette ember {
  0.00 0.02 0.00 0.03
  0.25 0.35 0.05 0.08
  0.50 0.90 0.25 0.10
  0.72 1.00 0.65 0.25
  0.88 1.00 0.95 0.80
  1.00 0.03 0.01 0.05
}
palette void {
  0.00 0.01 0.01 0.04
  0.40 0.05 0.15 0.35
  0.70 0.30 0.60 0.90
  1.00 0.90 0.95 1.00
}

timeline {
  0:00 scene=0 glow=0.5 die=0 spin=0
  2:00 scene=1 glow=0.9
  7:08 spin=0
  8:00 scene=2 spin=1.2 glow=0.8
  9:00 scene=1 spin=0 glow=1.25
  11:08 die=0 spin=0
  12:00 scene=2 spin=1.8 glow=1.0
  13:00 die=1
  13:08 glow=0.45
}

# ------------------------------------------------------------------ helpers
fn textline(s, px, py, sz) {
  cx = (u - px) / sz
  cy = (py - v) / sz
  i = floor(cx)
  return glyph(str(s, i), fract(cx), fract(cy)) * step(0, cx) * step(cx, strlen(s)) * step(0, cy) * step(cy, 1)
}
fn stars(lx, ly, f) {
  # one layer of twinkling point stars on a hashed grid
  gx = floor(lx * f + 60)
  gy = floor(ly * f + 60)
  h1 = hash(gx * 1.71 + gy * 91.7)
  px2 = fract(lx * f) - 0.5
  py2 = fract(ly * f) - 0.5
  sd = len(px2, py2)
  twk = 0.55 + 0.45 * sin(beat * 2.2 + h1 * 40)
  return exp(-sd * sd * (30 + 200 * h1)) * step(0.90, h1) * twk
}

# ------------------------------------------------------------------ instruments
# channels: 0 kick  1 snare/hat (sampled)  2 bass  3 drone  4 bell  5 arp
inst kick {
  f = 44 + 300 * exp(-t * 28)
  $p = $p + f / sr
  body = sin($p * tau) * exp(-t * 4.5)
  click = hp(noise(), 4000) * exp(-t * 200) * 0.5
  out(dist(body * 1.6 + click, 1.4) * 0.85)
}
inst dsnare {
  out(smp(snare, t) * 0.85)
}
inst dhat {
  out(smp(hat, t * (1.3 - 0.5 * vel)) * 0.5)
}
inst bass {
  e = env(0.004, 0.30, 0.6, 0.10)
  s = sin(ph * tau) * 0.9 + bsaw(ph, freq) * 0.3
  s = svf(s, 120 + 900 * e, 0.5)
  out(s * e * 0.55)
}
inst drone {
  e = env(0.8, 1.0, 0.9, 1.2)
  s = usaw(freq, 0.35) * 0.5 + sin(ph * tau * 0.5) * 0.6
  s = svf(s, 200 + 500 * e + 120 * sin(t * 0.23), 0.6)
  out(s * e * 0.16)
}
inst bell {
  # hollow FM bell: inharmonic partials, long decay
  e = env(0.002, 1.1, 0.0, 0.4)
  m = sin(ph * tau * 3.53) * exp(-t * 1.8) * 4.5
  s = sin(ph * tau + m) * 0.75
  s = s + sin(ph * tau * 2.756 + m * 0.35) * exp(-t * 2.6) * 0.4
  s = s + sin(ph * tau * 5.41) * exp(-t * 5.0) * 0.18
  out(s * e * 0.30)
}
inst arp {
  e = env(0.001, 0.18, 0.0, 0.06)
  s = bsaw(ph, freq) + bsqr(ph, 0.5, freq * 2) * 0.3
  s = svf(s, 300 + 5000 * e, 0.4)
  out(s * e * 0.25)
}

chan 3 {
  w = verb(x, 0.90, 0.40)
  out(x * 0.55 + w * 0.75)
}
chan 4 {
  d = dly(x, 0.5, 0.5)
  w = verb(x * 0.7 + d * 0.3, 0.85, 0.5)
  out(x + d * 0.45 + w * 0.35)
}
chan 5 {
  d = dly(x, 0.375, 0.42)
  out(x + d * 0.38)
}
master {
  w = verb(l * 0.4 + r * 0.4, 0.80, 0.55)
  out(dist(l + w * 0.14, 1.05) * 0.92, dist(r + w * 0.14, 1.05) * 0.92)
}

