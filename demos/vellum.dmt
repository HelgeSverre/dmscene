# --------------------------------------------------------------------- drawing
fn textline(s, px, py, sz) {
  cx = (u - px) / sz
  cy = (py - v) / sz
  i = floor(cx)
  return glyph(str(s, i), fract(cx), fract(cy)) * step(0, cx) * step(cx, strlen(s)) * step(0, cy) * step(cy, 1)
}
fn centred(s, py, sz) {
  return textline(s, -strlen(s) * sz * 0.5, py, sz)
}
fn ring(px, py, rr, thick) {
  return exp(-abs(len(px, py) - rr) / thick)
}
fn boxline(px, py, hx, hy, thick) {
  q = max(abs(px) / hx, abs(py) / hy)
  return exp(-abs(q - 1) / thick)
}
fn scroller(s, py, sz, speed) {
  per = (strlen(s) + 10) * sz
  px = aspect - fract(time * speed / per) * per
  return max(textline(s, px, py, sz), textline(s, px + per, py, sz))
}

uniform kickE snapE pluckE leadE turn drift gild reveal
frame {
  kickE = exp(-trig(0) * 8)
  snapE = exp(-trig(1) * 12) * (1 - step(80, note(1)))
  pluckE = exp(-trig(3) * 5)
  leadE = cenv(4)
  turn = beat * 0.055 + 0.12 * sin(beat * 0.11)
  drift = sin(beat * 0.09) * 0.5 + 0.5
  gild = 0.55 + 0.25 * sin(beat * 0.17) + pluckE * 0.20
  reveal = smooth(0, 2, time)
  select(evt(scene))
}

# Folio I: deckled parchment, manuscript type, a living botanical rosette.
pixel folio {
  px = u + 0.012 * sin(v * 4 + beat * 0.12)
  py = v + 0.009 * sin(u * 5 - beat * 0.09)
  grain = fbm(px * 5 + 17, py * 5 - 9, 4)
  stain = fbm(px * 1.25 - 3, py * 1.25 + 8, 3)
  fibre = sin(py * 530 + grain * 12) * 0.018
  pal(parchment, 0.53 + grain * 0.25 + stain * 0.16 + fibre)
  cmul(0.82 + reveal * 0.18)
  edge = max(abs(u) / aspect, abs(v))
  cmul(1 - 0.58 * smooth(0.69, 1.0, edge))

  border = boxline(px, py, 1.46, 0.86, 0.010)
  border2 = boxline(px, py, 1.41, 0.81, 0.006)
  corners = ring(abs(px) - 1.42, abs(py) - 0.82, 0.055, 0.009)
  ink = max(border * 0.64, max(border2 * 0.42, corners * 0.75))
  cmul(1 - ink * 0.72)

  # The rosette is drawn as polar equations rather than a texture.
  rx = px
  ry = py + 0.055
  rad = polar(rx, ry)
  ang = r1 + turn * 0.32
  rose = 0.205 + 0.065 * cos(ang * 8) + 0.018 * cos(ang * 16 - beat * 0.18)
  petals = exp(-abs(rad - rose) * 105)
  r1ing = ring(rx, ry, 0.335, 0.0045)
  r2ing = ring(rx, ry, 0.305, 0.0030)
  spokes = pow(abs(cos(ang * 6)), 52) * smooth(0.09, 0.14, rad) * (1 - smooth(0.28, 0.32, rad))
  heart = ring(rx, ry, 0.073 + kickE * 0.012, 0.009)
  gold = max(petals, max(r1ing * 0.85, max(r2ing * 0.65, max(spokes * 0.7, heart))))
  cadd(gold * (0.52 + gild * 0.38), gold * (0.24 + gild * 0.32), gold * 0.055)
  cmul(1 - exp(-abs(rad - 0.245) * 130) * 0.35)

  # Mirrored stems and leaves occupy the margins.
  mx = abs(px)
  stem = exp(-abs(mx - (1.20 + 0.045 * sin(py * 10 + turn))) * 95) * step(abs(py), 0.66)
  leafwave = abs(sin(py * 18 + turn * 2))
  leaves = exp(-abs(mx - (1.15 + leafwave * 0.11)) * 65) * pow(leafwave, 5) * step(abs(py), 0.62)
  cmul(1 - stem * 0.46)
  cadd(leaves * 0.19, leaves * 0.28, leaves * 0.075)

  ttl = centred(title, 0.62, 0.190)
  shadow = centred(title, 0.608, 0.190)
  cmul(1 - shadow * 0.52)
  cadd(ttl * (0.74 + pluckE * 0.25), ttl * (0.43 + gild * 0.25), ttl * 0.095)
  sub = centred(subtitle, 0.395, 0.048)
  cmul(1 - sub * 0.74)
  l1 = centred(line1, -0.485, 0.044)
  l2 = centred(line2, -0.600, 0.044)
  cmul(1 - max(l1, l2) * 0.76)
  seal = ring(px, py + 0.72, 0.024 + pluckE * 0.012, 0.008)
  cadd(seal * 0.42, seal * 0.025, seal * 0.035)
}

# Folio II: an armillary sphere and orbiting lamps on a star-sprinkled chart.
pixel armillary {
  px = u
  py = v + 0.025
  grain = fbm(px * 4 + 31, py * 4 + 12, 3)
  pal(parchment, 0.34 + grain * 0.26)
  cmul(0.70 + 0.10 * drift)
  edge = max(abs(u) / aspect, abs(v))
  cmul(1 - 0.65 * smooth(0.65, 1.0, edge))
  chart = boxline(px, py, 1.43, 0.82, 0.007)
  cmul(1 - chart * 0.65)

  # A sparse cellular star field behind the instrument.
  cell = vor(px * 5.2 + 8, py * 5.2 - 4)
  cid = r1
  stars = exp(-cell * 75) * step(0.64, cid) * (0.25 + 0.75 * hash(cid * 91))
  cadd(stars * 0.34, stars * 0.23, stars * 0.08)

  rad = polar(px, py)
  ang = r1
  outer = ring(px, py, 0.60, 0.005)
  outer2 = ring(px, py, 0.555, 0.003)
  ticks = pow(abs(cos((ang - turn * 0.3) * 24)), 70) * smooth(0.54, 0.56, rad) * (1 - smooth(0.60, 0.62, rad))
  cmul(1 - max(outer, max(outer2, ticks)) * 0.73)

  arms = 0
  repeat i 4 {
    qx = rot(px, py, turn * (0.5 + i * 0.11) + i * pi / 4)
    qy = r1
    ell = abs(len(qx, qy * (1.35 + i * 0.28)) - (0.47 + i * 0.026))
    arms = max(arms, exp(-ell * 135))
  }
  axis = exp(-abs(px * cos(turn) + py * sin(turn)) * 180) * (1 - smooth(0.54, 0.61, rad))
  cadd(arms * (0.54 + gild * 0.32), arms * (0.27 + gild * 0.27), arms * 0.055)
  cmul(1 - axis * 0.62)

  # Sun and moon travel on different periods; their previous positions linger.
  sa = beat * 0.23
  sx = cos(sa) * 0.47
  sy = sin(sa) * 0.30
  sun = exp(-len(px - sx, py - sy) * 55)
  ma = -beat * 0.16 + 2.1
  mx = cos(ma) * 0.56
  my = sin(ma) * 0.42
  moon = exp(-len(px - mx, py - my) * 70)
  cadd(sun * 1.05 + moon * 0.16, sun * 0.60 + moon * 0.32, sun * 0.10 + moon * 0.40)
  pulseRing = ring(px, py, fract(beat * 0.5) * 0.62, 0.008) * (1 - fract(beat * 0.5)) * pluckE
  cadd(pulseRing * 0.34, pulseRing * 0.12, pulseRing * 0.025)

  ttl = centred(title, 0.75, 0.095)
  cadd(ttl * 0.72, ttl * 0.42, ttl * 0.10)
  lab = centred(orbis, -0.665, 0.068)
  cmul(1 - lab * 0.72)
  foot = centred(line3, -0.765, 0.038)
  cmul(1 - foot * 0.72)
  cprevz(0.5, 0.5, 1.002, 0.0015 * sin(beat * 0.2), 0.10 + pluckE * 0.06)
}

# Folio III: the red initial, nocturnal ink and vegetal computation.
pixel initial {
  px = u
  py = v
  mist = fbm(px * 2.3 + beat * 0.006, py * 2.3, 4)
  pal(midnight, 0.12 + mist * 0.44 + (py + 1) * 0.06)
  fil = kali(px * 0.62 + 0.3, py * 0.62, 0.73, 0.79, 6)
  veins = exp(-fil * 20) * (0.20 + 0.30 * drift)
  cadd(veins * 0.07, veins * 0.22, veins * 0.19)

  border = boxline(px, py, 1.44, 0.84, 0.008)
  cadd(border * 0.33, border * 0.20, border * 0.055)
  # The oversized V has a vermilion body and eight gilt offsets.
  vx = -1.23
  vy = 0.51
  vs = 0.67
  halo = 0
  repeat k 8 {
    a = k * tau / 8 + turn * 0.08
    halo = max(halo, textline(initial, vx + cos(a) * 0.018, vy + sin(a) * 0.018, vs))
  }
  body = textline(initial, vx, vy, vs)
  cadd(halo * (0.68 + gild * 0.28), halo * (0.36 + gild * 0.25), halo * 0.055)
  cmul(1 - body * 0.82)
  cadd(body * 0.52, body * 0.025, body * 0.035)
  inner = textline(initial, vx + 0.008, vy - 0.008, vs * 0.94)
  cmul(1 - inner * 0.26)

  # Rubricated text is set as a measured column to the right of the initial.
  cadd(0.20, 0.12, 0.045)
  t1 = textline(line1, -0.38, 0.44, 0.047)
  t2 = textline(line2, -0.38, 0.20, 0.047)
  t3 = textline(line3, -0.38, -0.04, 0.047)
  t4 = textline(line4, -0.38, -0.28, 0.047)
  type = max(max(t1, t2), max(t3, t4))
  cadd(type * 0.74, type * 0.66, type * 0.40)
  rules = exp(-abs(py - 0.56) * 250) + exp(-abs(py + 0.49) * 250)
  rules = rules * step(-0.40, px) * (1 - step(1.28, px))
  cadd(rules * 0.38, rules * 0.08, rules * 0.035)

  # A quill-like gold filament writes a moving underline.
  writeX = -0.36 + fract(beat * 0.25) * 1.55
  nib = exp(-len(px - writeX, py + 0.405) * 65)
  cadd(nib * 0.85, nib * 0.52, nib * 0.12)
  spark = pow(max(0, sin(px * 27 + py * 19 - beat * 0.8)), 34) * leadE
  cadd(spark * 0.11, spark * 0.08, spark * 0.025)
}

# Folio IV: all the manuscript's systems overprint one another in gold feedback.
pixel overprint {
  px = rot(u, v, 0.018 * sin(beat * 0.08))
  py = r1
  grain = fbm(px * 3.2 + 4, py * 3.2 + beat * 0.004, 4)
  pal(parchment, 0.26 + grain * 0.25 + 0.05 * sin(px * 2 + turn))
  cmul(0.62 + 0.12 * drift)
  rad = polar(px, py + 0.03)
  ang = r1 - turn * 0.45
  lattice = pow(abs(cos(ang * 12)), 42) * (1 - smooth(0.72, 0.79, rad))
  rings = ring(px, py + 0.03, 0.60 + kickE * 0.025, 0.004)
  rings = max(rings, ring(px, py + 0.03, 0.43, 0.003))
  geometry = max(lattice * 0.42, rings)
  cadd(geometry * 0.34, geometry * 0.16, geometry * 0.035)

  # Orbital cells become tiny illuminated rubies around the title.
  cells = vor(cos(ang) * rad * 8 + turn, sin(ang) * rad * 8 - turn)
  gems = exp(-cells * 52) * smooth(0.38, 0.50, rad) * (1 - smooth(0.70, 0.78, rad))
  cadd(gems * (0.25 + pluckE * 0.55), gems * 0.035, gems * 0.045)

  # Feed back the chart, then set crisp type over its moving afterimage.
  cprevz(0.5, 0.51, 1.006 + kickE * 0.008, 0.003 + pluckE * 0.004, 0.18 + pluckE * 0.08)
  halo = 0
  repeat k 4 {
    halo = max(halo, centred(title, 0.31 + (k - 1.5) * 0.014, 0.245))
  }
  ttl = centred(title, 0.31, 0.245)
  cmul(1 - halo * 0.40)
  cadd(ttl * (0.86 + pluckE * 0.14), ttl * (0.55 + gild * 0.25), ttl * 0.14)
  sub = centred(subtitle, 0.015, 0.066)
  cmul(1 - sub * 0.70)
  rule = boxline(px, py, 1.42, 0.83, 0.006)
  cadd(rule * 0.34, rule * 0.17, rule * 0.035)
  scroll = scroller(colophon, -0.65, 0.072, 0.72)
  cadd(scroll * 0.84, scroll * 0.64, scroll * 0.28)
}

post {
  bloom = (tap(-2, 0) + tap(2, 0) + tap(0, -2) + tap(0, 2) + tap(-1, -1) + tap(1, 1)) / 6
  split = tap(-1 - floor(kickE * 2), 0)
  rr = mix(cget(0), split, 0.10 + snapE * 0.10)
  rgb(rr + bloom * 0.065, cget(1) + bloom * 0.050, cget(2) + bloom * 0.035)
  vign = max(abs(u) / aspect, abs(v))
  cmul(1 - 0.25 * smooth(0.68, 1.0, vign))
  grain = (hash(floor(x * w) * 0.713 + floor(y * h) * 19.17 + frame * 0.017) - 0.5) * 0.018
  cadd(grain, grain, grain)
}
