# ------------------------------------------------------------------ instruments
inst doum {
  f = 47 + 300 * exp(-t * 24)
  $p = $p + f / sr
  body = sin($p * tau) * exp(-t * 4.4)
  skin = lp(noise(), 340) * exp(-t * 30)
  out(dist((body * 1.15 + skin * 0.55) * 1.4, 1.15) * 0.64)
}
inst tak {
  e = exp(-t * 30)
  n = svf(noise(), 2100 + 1600 * vel, 0.55)
  out((r2 * 0.95 + sin(tau * 760 * t) * exp(-t * 65) * 0.12) * e * 0.30)
}
inst shaker {
  out(hp(noise(), 7200) * exp(-t * (46 + 60 * (1 - vel))) * 0.16)
}
inst bass {
  e = env(0.006, 0.18, 0.45, 0.12)
  s = sin(ph * tau) * 0.92 + saw(ph) * 0.20
  s = svf(s, 130 + 520 * e + 260 * p0, 0.28)
  out(dist(s * e, 1.2) * 0.46)
}
inst drone nna=continue {
  e = env(0.55, 0.9, 0.86, 2.2)
  a = saw(ph) * 0.5 + saw(ph + 0.0016) * 0.5
  s = svf(a, 170 + 240 * e + 320 * p0, 0.16)
  out((s * 0.50 + sin(ph * 0.5 * tau) * 0.24) * e * 0.30)
}
inst oud {
  e = exp(-t * 3.2)
  m = sin(ph * tau * 2.003 + 0.4) * 2.1 * exp(-t * 8)
  s = sin(ph * tau + m) + sin(ph * tau * 3.01) * 0.24 * exp(-t * 11)
  s = svf(s, 620 + 2800 * e + 1800 * p0, 0.32)
  out(s * e * 0.28)
}
inst ney {
  e = env(0.09, 0.30, 0.82, 0.45)
  vib = 0.24 * sin(t * 5.4) + 0.06 * sin(t * 12.7)
  tone = sin(ph * tau + vib) + sin(ph * tau * 2) * 0.10
  br = svf(hp(noise(), 700), 2300, 0.5)
  out((tone * 0.56 + r2 * 0.07) * e * 0.30)
}
inst bell {
  e = exp(-t * 0.95)
  m = sin(ph * tau * 1.41 + t * 0.3) * 1.7 * exp(-t * 1.8)
  out((sin(ph * tau + m) + sin(ph * tau * 2.76) * 0.35 + sin(ph * tau * 5.4) * 0.12) * e * 0.20)
}
inst air nna=continue {
  e = env(1.30, 1.0, 0.9, 2.0)
  n = svf(noise(), 380 + 900 * p0 + 180 * sin(t * 0.19), 0.42)
  out((n * 0.85 + r2 * 0.25) * e * 0.15)
}

chan 3 {
  w = verb(x, 0.86, 0.40)
  out(x * 0.78 + w * 0.55)
}
chan 4 {
  d = dly(x, 0.4688, 0.34)
  out(x + d * 0.34)
}
chan 5 {
  d = dly(x, 0.6250, 0.38)
  v = verb(x, 0.80, 0.45)
  out(x * 0.82 + d * 0.30 + v * 0.34)
}
chan 6 {
  w = verb(x, 0.88, 0.50)
  out(x * 0.70 + w * 0.72)
}

master {
  dl = dly(l, 0.3125, 0.30)
  dr = dly(r, 0.4688, 0.30)
  vl = verb(l + dr * 0.14, 0.80, 0.44)
  vr = verb(r + dl * 0.14, 0.80, 0.44)
  out(dist(l * 0.92 + dr * 0.14 + vl * 0.13, 1.04),
      dist(r * 0.92 + dl * 0.14 + vr * 0.13, 1.04))
}

