# ------------------------------------------------------------------ visuals
uniform sun dust reveal sunEl dustAmt revK horizon panX sunX doumE takE neyE oudE bellE storm dayK

fn capsule(px, py, ax, ay, bx, by, r) {
  vx = bx - ax
  vy = by - ay
  qx = px - ax
  qy = py - ay
  hh = clamp((qx * vx + qy * vy) / (vx * vx + vy * vy + 0.0001), 0, 1)
  return len(qx - vx * hh, qy - vy * hh) - r
}

fn camel(px, py, ph) {
  # local units: feet at y=0, standing height ~1.2
  sw = 0.09 * sin(ph)
  s2 = 0.09 * sin(ph + 3.1416)
  d = capsule(px, py, 0.28 + sw, 0.50, 0.28 + sw * 0.4, 0.0, 0.032)
  d = min(d, capsule(px, py, 0.15 + s2, 0.48, 0.15, 0.0, 0.032))
  d = min(d, capsule(px, py, -0.25 - sw, 0.50, -0.25, 0.0, 0.035))
  d = min(d, capsule(px, py, -0.36 - s2, 0.48, -0.36, 0.0, 0.035))
  d = min(d, (len(px / 0.48, (py - 0.58) / 0.19) - 1) * 0.19)
  d = min(d, (len((px + 0.02) / 0.26, (py - 0.76) / 0.13) - 1) * 0.13)
  d = min(d, capsule(px, py, 0.38, 0.64, 0.57, 0.88, 0.050))
  d = min(d, (len((px - 0.61) / 0.11, (py - 0.92) / 0.055) - 1) * 0.055)
  d = min(d, (len((px - 0.72) / 0.06, (py - 0.885) / 0.038) - 1) * 0.038)
  d = min(d, capsule(px, py, -0.46, 0.60, -0.52, 0.38, 0.016))
  # robed rider
  d = min(d, (len((px - 0.02) / 0.10, (py - 0.99) / 0.16) - 1) * 0.10)
  d = min(d, (len((px - 0.04) / 0.055, (py - 1.155) / 0.055) - 1) * 0.055)
  return 1 - smooth(-0.022, 0.022, d)
}

fn walker(px, py) {
  d = (len(px / 0.15, (py - 0.38) / 0.38) - 1) * 0.15
  d = min(d, (len((px - 0.01) / 0.080, (py - 0.86) / 0.080) - 1) * 0.080)
  d = min(d, capsule(px, py, 0.16, 0.02, 0.16, 0.92, 0.013))
  return 1 - smooth(-0.02, 0.02, d)
}

fn ridgeline(x, d, idx) {
  freq = 4.4 - 2.9 * d
  aa = x * freq + panX * (0.2 + 2.4 * d) + idx * 5.3 + 0.30 * sin(x * 2.2 + t * 0.02 + idx * 1.7)
  q = fract(aa) - 0.5
  dh = (1 - abs(q * 2)) ^ 0.7
  dh = 0.74 * dh + 0.26 * (1 - abs((fract(aa * 2.17 + 0.31) - 0.5) * 2)) ^ 0.9
  return horizon + 0.005 + 0.215 * d ^ 1.6 - (0.010 + 0.080 * d ^ 1.4) * dh
}

frame {
  sunEl = evtl(sun)
  dustAmt = evtl(dust)
  revK = evtl(reveal)
  doumE = exp(-trig(0) * 6.5) * step(0.35, vel(0))
  takE = exp(-trig(1) * 22)
  neyE = exp(-trig(5) * 0.8)
  oudE = exp(-trig(4) * 3.2)
  bellE = exp(-trig(6) * 0.7)
  storm = smooth(0.35, 0.95, dustAmt)
  dayK = smooth(0.02, 0.36, sunEl)
  horizon = 0.400 + 0.028 * smooth(0, 40, t) + 0.004 * sin(beat * 0.19) - 0.004 * doumE
  panX = t * 0.0022 + 0.012 * sin(t * 0.041)
  sunX = 0.585 - 0.015 * sin(t * 0.023)
}

pixel {
  # ---------- sky
  sv = clamp(y / max(horizon, 0.06), 0, 1) ^ 1.35
  pal(skyDay, sv)
  mixpal(skyNight, sv, 1 - dayK)

  # ---------- sun and its glow
  sy = horizon + 0.030 - 0.335 * sunEl
  ds = len((x - sunX) * aspect, y - sy)
  ds = ds * (1 + 0.010 * (hash(x * 811.7 + y * 617.3 + frame) - 0.5))
  halo = exp(-ds * 6.0) * 0.55 + exp(-ds * 2.2) * 0.24
  disc = 1 - smooth(0.049, 0.054, ds)
  az = exp(-abs(x - sunX) * 2.6) * exp(-abs(y - horizon) * 9.0)
  sunK = 1 - 0.72 * storm
  cadd((halo * 0.95 + disc * 1.25) * sunK + az * 0.45 * (0.3 + sunEl),
       (halo * 0.50 + disc * 0.86) * sunK + az * 0.22 * (0.3 + sunEl),
       (halo * 0.20 + disc * 0.48) * sunK + az * 0.10 * (0.3 + sunEl))

  # ---------- cloud bands
  cf = fbm(x * 2.0 + 5.0 + t * 0.006, (y - horizon) * 10.0 + 2.0, 2)
  cm = smooth(0.47, 0.65, cf + 0.09 * sin(x * 12.0 + t * 0.05 + (y - horizon) * 4.0))
  cm = cm * smooth(0.012, 0.070, horizon - y) * (0.45 + 0.55 * exp(-abs(y - sy) * 3.2))
  mixpal(dust, 0.62 + 0.30 * dayK, min(cm * 0.62, 0.55))

  # ---------- stars
  hs = hash(floor(x * 190) * 1.7 + floor(y * 220) * 91.3)
  star = step(0.9972, hs) * (0.45 + 0.55 * sin(t * 2.1 + hs * 41.0))
  star = star * (1 - smooth(0.04, 0.40, sunEl)) * smooth(0.02, 0.12, horizon - y) * (1 - smooth(0.20, 0.40, horizon - y))
  cadd(star * 0.80, star * 0.84, star * 1.00)

  # ---------- dune sea: four ridges, far to near, lit from the sun side
  dR = cget(0)
  dG = cget(1)
  dB = cget(2)
  repeat i 4 {
    d = i * 0.3333
    freq = 3.8 - 2.4 * d
    aa = x * freq + panX * (0.2 + 2.4 * d) + i * 5.3 + 0.35 * sin(x * 2.0 + t * 0.02 + i * 1.7)
    qu = fract(aa)
    dh = 0.5 - 0.5 * cos(qu * tau)
    dh = 0.80 * dh + 0.20 * (0.5 - 0.5 * cos(fract(aa * 2.3 + 0.31) * tau))
    cy = horizon + 0.008 + 0.215 * d ^ 1.6 - (0.026 + 0.100 * d ^ 1.4) * dh
    m = smooth(cy - 0.0013, cy + 0.0013, y)
    db = y - cy
    lit = 0.5 - 0.5 * smooth(-0.55, 0.55, sin(aa * tau))
    rr = exp(-db / (0.0042 + 0.012 * d))
    ff = exp(-db / (0.010 + 0.095 * d))
    rip = sin(db * (120 + 210 * d + 45 * sin(x * 5.0 + i)) + x * 13 + qu * 6) * 0.5 + 0.5
    rip = rip * smooth(0.005, 0.045, db) * (0.35 + 0.65 * d)
    tone = 0.05 + 0.44 * lit + 0.34 * ff + 0.50 * rr * (0.40 + 0.90 * sunEl) * (0.30 + 0.70 * d) + 0.075 * rip
    tone = tone * (0.93 + 0.11 * sin(aa * 0.63 + i * 2.1))
    pal(sandDay, clamp(tone, 0, 1))
    mixpal(sandNight, clamp(tone, 0, 1), 1 - dayK)
    hk = (1 - d) ^ 1.5 * 0.92
    mixpal(skyDay, 0.72, hk * dayK * 0.9)
    mixpal(skyNight, 0.52, hk * (1 - dayK) * 0.9)
    dR = mix(dR, cget(0), m)
    dG = mix(dG, cget(1), m)
    dB = mix(dB, cget(2), m)
  }

  # ---------- lone walker on a middle ridge
  wx0 = 0.315 + 0.012 * sin(t * 0.03)
  gy = ridgeline(wx0, 0.6667, 2)
  wm = walker((x - wx0) * aspect / 0.031, (gy - y) / 0.031) * smooth(0.02, 0.10, horizon - gy)
  dR = mix(dR, 0.030 + 0.10 * dayK, wm)
  dG = mix(dG, 0.020 + 0.06 * dayK, wm)
  dB = mix(dB, 0.026 + 0.05 * dayK, wm)

  # ---------- caravan on the near crest
  cx0 = -0.10 + 0.0340 * (t - 19.0)
  csz = 0.058
  ca = smooth(19.0, 21.0, t)
  repeat k 2 {
    cxk = cx0 + k * 0.098
    cgy = ridgeline(cxk, 1.0, 3)
    cmk = camel((x - cxk) * aspect / csz, (cgy - y) / csz, t * 3.2 + k * 2.1) * ca
    dR = mix(dR, 0.022 + 0.05 * dayK, cmk)
    dG = mix(dG, 0.015 + 0.03 * dayK, cmk)
    dB = mix(dB, 0.020 + 0.03 * dayK, cmk)
  }

  # ---------- sun path on the sand
  gl = exp(-abs(x - sunX) * 15.0) * exp(-min(y - horizon, 0.4) * 2.4) * (0.10 + 0.55 * sunEl)
  gl = gl * (0.55 + 0.45 * sin(y * 150 - t * 1.3 + x * 7))
  dR = dR + gl * 0.55
  dG = dG + gl * 0.26
  dB = dB + gl * 0.10

  # ---------- blowing sand
  repeat k 3 {
    h1k = hash(k * 7.31 + 1.7)
    h2k = hash(k * 3.77 + 9.2)
    px = fract(h2k + t * (0.020 + 0.055 * h1k) + y * 0.22)
    py = horizon + 0.025 + h1k * 0.36
    st = exp(-len((x - px) * 1.7, (y - py) * 30.0) * 5.0) * (0.35 + 0.65 * h2k)
    dR = dR + st * dustAmt * 0.26
    dG = dG + st * dustAmt * 0.18
    dB = dB + st * dustAmt * 0.11
  }

  # ---------- storm veil and exposure
  rgb(dR, dG, dB)
  mixpal(dust, 0.80, min(storm * 0.60, 0.60))
  dR = cget(0)
  dG = cget(1)
  dB = cget(2)
  dR = dR + storm * 0.06
  dG = dG + storm * 0.035
  dB = dB + storm * 0.02
  ex = 0.88 + 0.20 * takE + 0.10 * doumE
  rgb(dR * ex, dG * ex, dB * ex)
}

post {
  # heat shimmer, strongest at the horizon
  sh = (0.55 + 0.45 * sin(t * 1.7)) * (0.45 + 1.1 * dustAmt) * (0.25 + 0.75 * dayK)
  wob = 0.85 * exp(-abs(y - horizon) * 8.0) + 0.22
  dyy = (sin(y * 330 + t * 6.3) + 0.5 * sin(y * 128 - t * 3.1)) * 1.7 * sh * wob
  dxx = sin(x * 205 + t * 4.7) * 0.8 * sh * wob
  a = tap(dxx, dyy)
  ag = r1
  ab = r2
  bl = (tap(-3, 0) + tap(3, 0) + tap(0, -3) + tap(0, 3)) * 0.25
  rs = tap(1.2 + takE, 0)
  bs = tap(-1.2, 0)
  ar = mix(a, rs, 0.20)
  abl = mix(ab, r2, 0.20)
  rgb(ar + bl * 0.15, ag + bl * 0.11, abl + bl * 0.17)
  d = len(u, v)
  cmul(1 - 0.34 * d * d)
  cmul(1 - 0.10 * storm)
  gn = hash(x * w * 0.37 + y * h * 1.13 + frame * 7.7) - 0.5
  cadd(gn * 0.032, gn * 0.029, gn * 0.034)
  cmul(1 - step(y, 0.050) - step(0.950, y))
}
