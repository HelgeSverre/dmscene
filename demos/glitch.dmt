# @collection Demos
# @music breakcore: the sampled kit pitched by note, reversed snares via Sxx, E9x rolls, an E6x stutter loop, EDx delays, reese bass, FM screams, snare bitcrush and master drive opened by Wxx
# @visual datamosh over a pulsing Mandelbrot: hashed block displacement of the previous frame, row tearing and RGB split on the snare, posterisation that coarsens with the timeline, inverted kick flashes, noise snow on the screams
# glitch.dmt - breakcore at 180 bpm over datamoshed Mandelbrot video.
# Drums are the sampled kit, pitched by note, chopped with E9x rolls, E6x pattern loops and EDx delays.
title GLITCH
song bpm=180 speed=3 rpb=8 channels=6 loop=0 volume=0.58 dither=1
order 0 0 1 2 1 3 0 1 2 3 4

sample kick "assets/kick.wav"
sample snare "assets/snare.wav"
sample hat "assets/hat.wav"
sample ride "assets/ride.wav"

timeline {
  0:00 zoomk=0 mosh=0.2
  2:00 mosh=0.5
  4:00 mosh=0.9 zoomk=1
  6:00 mosh=0.3
  8:00 mosh=1.0 zoomk=2
  10:00 mosh=0.6
}

inst skick {
  out(smp(kick, t * freq / 261.6) * 0.95)
}
inst ssnare {
  # pitched by note; reversed when p0 > 0.5
  rate = freq / 261.6
  sp = p0 > 0.5 ? smplen(snare) - t * rate : t * rate
  out(smp(snare, sp) * 0.85)
}
inst shat {
  out(smp(hat, t * freq / 261.6) * 0.6)
}
inst sride {
  out(smp(ride, t * freq / 261.6) * 0.45)
}
inst reese {
  e = env(0.01, 0.3, 0.8, 0.1)
  s = bsaw(ph + 0.003 * t, freq) + bsaw(ph - 0.0025 * t, freq) + bsaw(ph * 0.5, freq * 0.5) * 0.6
  s = svf(s, 150 + 900 * e * (0.5 + p0), 0.5)
  out(dist(s, 1.6) * e * 0.5)
}
inst scream {
  e = env(0.003, 0.2, 0.5, 0.05)
  m = sin(ph * tau * 3.01) * (4 + 6 * exp(-t * 5))
  s = sin(ph * tau + m) + bsqr(ph, 0.2, freq) * 0.5
  s = dist(s * 3, 2.5)
  s = svf(s, 1500 + 4000 * e, 0.5)
  out(s * e * 0.32)
}

chan 1 {
  # snares get a bitcrush that opens with mp0 (Wxx) and a slap
  c = crush(x, 256 - 240 * mp0)
  d = dly(c, 0.1667, 0.3)
  out(c + d * 0.3)
}
master {
  d = dly(l * 0.5 + r * 0.5, 0.3333, 0.35)
  d = svf(d, 2500, 0.3)
  ol = dist(l + d * 0.2, 1.8 + 1.5 * mp0)
  or = dist(r + d * 0.2, 1.8 + 1.5 * mp0)
  out(ol, or)
}

# channels: 0 kick  1 snare  2 hat  3 ride  4 reese  5 scream      rows are 32nds (8 per beat)
pattern 0 rows=32 {
