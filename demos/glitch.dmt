uniform kickE snE scrE moshA zoomA blockseed tear

frame {
  kickE = exp(-trig(0) * 12)
  snE = exp(-trig(1) * 10)
  scrE = exp(-trig(5) * 6)
  moshA = evtl(mosh)
  zoomA = evtl(zoomk)
  blockseed = floor(beat * 4) + 100 * floor(bar)     # new displacement field every 16th
  tear = step(0.6, snE)
}
pixel {
  # the "video": a mandelbrot zoom pulsing with the kick
  zm = 1.2 + zoomA * 2 + kickE * 0.4
  it = mandel(-0.745 + u / zm * 0.9, 0.186 + v / zm * 0.9, 64)
  k = log(1 + it) / log(65)
  hsv(k * 1.5 + bar * 0.05, 0.9, (0.1 + 1.3 * k * k) * (1 - step(64, it)))
  # datamosh: blocks of the previous frame slide by a hashed vector; stronger on the snare
  bx = floor(x * 16)
  by = floor(y * 10)
  hv = hash(bx * 1.3 + by * 7.1 + blockseed)
  hv2 = hash(bx * 2.7 + by * 3.9 + blockseed + 5)
  amt = moshA * (0.3 + 0.7 * snE) * step(0.35, hv)
  ox = (hv - 0.5) * 0.3 * amt
  oy = (hv2 - 0.5) * 0.2 * amt
  # row tearing: horizontal bands shift on the snare
  band = floor(y * 24)
  ox = ox + tear * (hash(band * 9.1 + blockseed) - 0.5) * 0.25
  keep = 0.55 + 0.4 * moshA
  cprev(x + ox, y + oy, keep)
  # rgb split: pull red and blue from displaced copies
  pr = prev(x + ox + 0.012 * snE, y + oy)
  pb = prev(x + ox - 0.012 * snE, y + oy)
  bq = r2
  rgb(mix(cget(0), pr, 0.5 * snE), cget(1), mix(cget(2), bq, 0.5 * snE))
  # posterise harder as the breaks get rougher, invert on the kick attack
  lv = 8 - 5 * moshA
  rgb(floor(cget(0) * lv + 0.5) / lv, floor(cget(1) * lv + 0.5) / lv, floor(cget(2) * lv + 0.5) / lv)
  inv = step(0.6, kickE) * step(0.5, moshA)
  rgb(mix(cget(0), 1 - cget(0), inv), mix(cget(1), 1 - cget(1), inv), mix(cget(2), 1 - cget(2), inv))
  # scream: white noise snow
  snow = step(0.995 - 0.03 * scrE, hash(x * 913 + y * 677 + frame)) * scrE
  cadd(snow, snow, snow)
}
post {
  cmul(1 - 0.2 * step(0.5, fract(y * h * 0.5)))
}
