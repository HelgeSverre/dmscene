# hakkuh.dmt - Rotterdam hardcore. 180 bpm, the kick is the bassline.
# WARNING: strobes on every kick.
title HAKKUH
song bpm=180 speed=6 rpb=4 channels=6 loop=0 volume=0.5
order 0 0 1 1 2 6 2 6 3 3 4 1 1 2 6 5

# ------------------------------------------------------------------ instruments
inst kick {
  # 909 body into a wall of overdrive: pitch drops 1500 -> 55 Hz, tanh squares it off
  f  = 55 + 170 * exp(-t * 16) + 1500 * exp(-t * 95)
  $p = $p + f / sr
  s  = sin($p * tau)
  s  = dist(s * (4 + 8 * p0) * exp(-t * 2.4), 3.2)
  s  = svf(s, 2600 + 5000 * exp(-t * 9), 0.15)
  out(s * 0.8)
}
inst hoover {
  # alpha juno "what the": three detuned saws + pwm sub, pitch falls 5 semitones into the note
  e  = env(0.012, 0.35, 0.8, 0.18)
  sw = 2 ^ ((5 * exp(-t * 5)) / 12)
  f  = freq * sw
  $a = $a + f / sr
  $b = $b + f * 1.011 / sr
  $c = $c + f * 0.989 / sr
  $d = $d + f * 0.5 / sr
  pw = 0.5 + 0.35 * sin(t * 6 + 1)
  s  = saw($a) + saw($b) + saw($c) + sqr($d, pw) * 0.8 + sqr($a * 2, 0.3) * 0.3
  s  = svf(s, 1100 + 2600 * e + 2000 * p0, 0.35)
  out(dist(s * 0.6, 1.5) * e * 0.58)
}
inst hat {
  out(hp(noise(), 8000) * exp(-t * (70 - 55 * vel)) * 0.3)
}
inst lead {
  # hardcore square lead: two detuned squares + an octave saw, a little drive, vibrato after the attack
  e  = env(0.003, 0.2, 0.6, 0.08)
  vib = 1 + 0.004 * sin(t * 6.5) * min(t * 4, 1)
  f  = freq * vib
  $a = $a + f / sr
  $b = $b + f * 1.004 / sr
  s  = sqr($a, 0.5) + sqr($b, 0.5) + saw($a * 2) * 0.35
  s  = svf(s, 1800 + 2500 * e, 0.2)
  out(dist(s * 0.5, 1.3) * e * 0.5)
}
inst hit {
  # orchestra hit: stacked saws, root fifth octave tenth, with a noise crack
  e = env(0.001, 0.28, 0.0, 0.06)
  s = saw(ph) + saw(ph * 1.498 + 0.2) + saw(ph * 2.003) + saw(ph * 2.52 + 0.1) * 0.6 + noise() * exp(-t * 40) * 0.6
  s = svf(s, 700 + 4500 * e, 0.3)
  out(dist(s * 0.6, 1.5) * e * 0.5)
}
inst riser {
  e = env(0.02, 0.1, 1.0, 0.3)
  s = svf(noise(), 250 + 9000 * min(t / 2.6, 1), 0.75)
  out((s + r2 * 0.5) * e * 0.3 * (0.4 + 0.6 * min(t / 2.6, 1)))
}

master {
  # short slap to glue, a little hall on the synths, then crush everything against the ceiling
  d = dly(l * 0.5 + r * 0.5, 0.0833, 0.15)
  w = verb(hp(l * 0.5 + r * 0.5, 400), 0.72, 0.5)
  ol = dist(l + d * 0.15 + w * 0.12, 1.9)
  or = dist(r + d * 0.15 + w * 0.12, 1.9)
  out(ol, or)
}

