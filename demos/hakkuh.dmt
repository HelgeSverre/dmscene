}

# ------------------------------------------------------------------ shape helpers (inlined fns)
fn segd(px, py, ax, ay, bx, by) {
  dx = bx - ax
  dy = by - ay
  tt = clamp(((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy), 0, 1)
  return len(px - ax - dx * tt, py - ay - dy * tt)
}
fn elld(px, py, cx, cy, rx, ry) {
  return (len((px - cx) / rx, (py - cy) / ry) - 1) * min(rx, ry)
}
fn fill(d) {
  return 1 - smooth(-0.004, 0.004, d)
}
fn flame(px, py, y0, y1, w, seed, spd) {
  hf = clamp((py - y0) / (y1 - y0), 0, 1)
  wob = (fbm(px * 5 + seed, py * 4 - time * spd, 3) - 0.5) * (0.08 + 0.25 * hf)
  wid = w * (1 - hf) ^ 0.75 * (1 + 0.5 * wob / w)
  d = abs(px + wob * 0.6) - wid
  return max(d, max(min(y0, y1) - py, py - max(y0, y1)))
}

# ------------------------------------------------------------------ visuals
uniform zoom ang kickE hoovE strobe sx sy cx cy melt hitE mascot

frame {
  kickE = exp(-trig(0) * 12)
  hoovE = exp(-trig(1) * 2.5)
  hitE  = exp(-trig(4) * 6)
  strobe = step(0.5, kickE)                        # ~2 frames of inversion per kick
  sx = (hash(frame * 1.7) - 0.5) * 0.1 * kickE     # screen shake
  sy = (hash(frame * 2.3) - 0.5) * 0.1 * kickE
  zoom = 1.0 + 0.3 * kickE + 0.4 * hitE
  $a = $a + 0.012 * (step(0.5, fract(bar * 0.5)) * 2 - 1)   # spin flips direction every bar
  ang = $a
  th = hash(floor(bar) + 3) * tau                  # hard-cut julia parameter every bar
  cx = 0.7885 * cos(th)
  cy = 0.7885 * sin(th)
  melt = hoovE * 0.7
  mascot = (1 - step(4.1, trig(5))) * step(0.02, trig(5)) + hitE * 0.8   # breakdown + build, and on every hit
}
pixel {
  px = rot(abs(u) + sx, v + sy, ang) / zoom        # mirrored left/right
  py = r1 / zoom
  it = julia(px * 1.25, py * 1.25, cx, cy, 48)
  k = it / 48
  inside = step(1, k)
  kb = log(1 + it) / log(49)                       # log scale so the far field gets stripes too
  band = step(0.5, fract(kb * 7 - beat * 0.5))     # black/white bands racing outward on the beat
  bw = band * (1 - inside)
  red = inside * (0.45 + 0.55 * kickE)
  rgb(bw + red, bw * (1 - 0.5 * hitE), bw * (1 - 0.8 * hitE))
  cmul(1 - 0.35 * step(0.5, fract(y * h * 0.5)))   # scanlines
  # melt: drag the previous frame through noise while the hoover rings
  dx = (fbm(x * 6, y * 6 + beat, 2) - 0.5) * melt * 0.3
  dy = (fbm(x * 6 + 7, y * 6 - beat, 2) - 0.5) * melt * 0.3
  cprev(x + dx, y + dy + 0.004, melt * 0.85)
  # ---- the wizard: flame-haired, fists up, ring behind; drawn from signed distances over the fractal
  px = (u + sx * 0.5) * 1.15
  py = (v + sy * 0.5) * 1.15 - 0.05
  wa = abs(px)
  cr = cget(0)
  cg = cget(1)
  cb = cget(2)
  am = 0
  mk = min(mascot, 1)
  # ring: blue upper-left to red lower-right, thin white inner line
  rd = abs(len(px, py + 0.1) - 0.75) - 0.055
  rk = 0.5 + 0.5 * sin(atan2(py + 0.1, px) - 0.8)
  m = fill(rd) * mk
  cr = mix(cr, mix(0.15, 1.0, rk), m)
  cg = mix(cg, mix(0.35, 0.15, rk), m)
  cb = mix(cb, mix(1.0, 0.05, rk), m)
  m = fill(abs(len(px, py + 0.1) - 0.69) - 0.012) * mk
  cr = mix(cr, 0.9, m)
  cg = mix(cg, 0.9, m)
  cb = mix(cb, 0.9, m)
  # robe
  bd = max(wa - (0.38 + 0.12 * max(-py, 0)), max(py - 0.02, -0.72 - py))
  m = fill(bd) * mk
  shade = 0.6 + 0.4 * smooth(-0.9, 0.0, py)
  cr = mix(cr, 0.95 * shade, m)
  cg = mix(cg, 0.25 * shade, m)
  cb = mix(cb, 0.05 * shade, m)
  # arms: shoulder -> elbow -> fist, pumping on the kick
  fy = 0.62 + 0.06 * kickE
  aL = min(segd(px, py, -0.3, -0.02, -0.64, 0.24), segd(px, py, -0.64, 0.24, -0.56, fy)) - 0.085
  aR = min(segd(px, py, 0.3, -0.02, 0.64, 0.24), segd(px, py, 0.64, 0.24, 0.56, fy)) - 0.085
  m = fill(min(aL, aR)) * mk
  cr = mix(cr, 1.0, m)
  cg = mix(cg, 0.32, m)
  cb = mix(cb, 0.05, m)
  # beard: flame pointing down from the chin, dark streaks
  fd = flame(px, py, 0.16, -1.0, 0.32, 3, 0.7)
  m = fill(fd) * mk
  hb = clamp((0.16 - py) / 1.16, 0, 1)
  streak = step(0.72, fract(fbm(px * 6 + 1, py * 3 - time * 0.5, 2) * 5 + px * 3))
  cr = mix(cr, mix(1.0, 0.75, hb) - 0.45 * streak, m)
  cg = mix(cg, mix(0.45, 0.08, hb) - 0.2 * streak, m)
  cb = mix(cb, 0.03, m)
  # head, moustache, mouth, nose, eyes, brows
  m = fill(elld(px, py, 0, 0.3, 0.18, 0.21)) * mk
  cr = mix(cr, 1.0, m)
  cg = mix(cg, 0.72, m)
  cb = mix(cb, 0.5, m)
  m = fill(min(elld(px, py, -0.1, 0.16, 0.14, 0.045), elld(px, py, 0.1, 0.16, 0.14, 0.045))) * mk
  cr = mix(cr, 1.0, m)
  cg = mix(cg, 0.4, m)
  cb = mix(cb, 0.03, m)
  m = fill(elld(px, py, 0, 0.1, 0.06 + 0.02 * hoovE, 0.035 + 0.03 * hoovE)) * mk
  cr = mix(cr, 0.15, m)
  cg = mix(cg, 0.02, m)
  cb = mix(cb, 0.02, m)
  m = fill(elld(px, py, 0, 0.22, 0.04, 0.055)) * mk
  cr = mix(cr, 0.95, m)
  cg = mix(cg, 0.6, m)
  cb = mix(cb, 0.4, m)
  m = fill(min(elld(px, py, -0.085, 0.3, 0.055, 0.022), elld(px, py, 0.085, 0.3, 0.055, 0.022))) * mk
  cr = mix(cr, 1, m)
  cg = mix(cg, 1, m)
  cb = mix(cb, 0.95, m)
  m = fill(min(len(px + 0.08, (py - 0.3) * 1.5) - 0.018, len(px - 0.08, (py - 0.3) * 1.5) - 0.018)) * mk
  cr = mix(cr, 0.05, m)
  cg = mix(cg, 0.02, m)
  cb = mix(cb, 0.02, m)
  m = fill(min(segd(px, py, -0.17, 0.39, -0.03, 0.33), segd(px, py, 0.17, 0.39, 0.03, 0.33)) - 0.028) * mk
  cr = mix(cr, 0.2, m)
  cg = mix(cg, 0.05, m)
  cb = mix(cb, 0.0, m)
  # hair: flame pointing up, brighter on the kick
  m = fill(flame(px, py, 0.44, 1.05, 0.2, 7, 1.6)) * mk
  hh = clamp((py - 0.44) / 0.6, 0, 1)
  cr = mix(cr, 1.0, m)
  cg = mix(cg, mix(0.85, 0.25, hh) + 0.2 * kickE, m)
  cb = mix(cb, mix(0.2, 0.0, hh), m)
  # fists and knuckles
  m = fill(min(len(px + 0.56, py - fy - 0.06) - 0.115, len(px - 0.56, py - fy - 0.06) - 0.115)) * mk
  cr = mix(cr, 1.0, m)
  cg = mix(cg, 0.7, m)
  cb = mix(cb, 0.48, m)
  kd = min(segd(px, py, -0.64, fy + 0.12, -0.48, fy + 0.12), segd(px, py, 0.48, fy + 0.12, 0.64, fy + 0.12)) - 0.012
  kd = min(kd, min(segd(px, py, -0.62, fy + 0.04, -0.5, fy + 0.04), segd(px, py, 0.5, fy + 0.04, 0.62, fy + 0.04)) - 0.012)
  m = fill(kd) * mk
  cr = mix(cr, 0.6, m)
  cg = mix(cg, 0.3, m)
  cb = mix(cb, 0.15, m)
  rgb(cr, cg, cb)
  # strobe: invert on the kick attack
  rr = cget(0)
  gg = cget(1)
  bb = cget(2)
  rgb(mix(rr, 1 - rr, strobe), mix(gg, 1 - gg, strobe), mix(bb, 1 - bb, strobe))
}
