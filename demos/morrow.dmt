# ------------------------------------------------------------------ visuals
uniform wBranch wSky grow storm camZ camA warm trail titleA kickE arpE bellE padE

fn titleline(s, py, sz) {
  n = strlen(s)
  cx = (u + n * sz * 0.5) / sz
  cy = (py - v) / sz
  i = floor(cx)
  g = glyph(str(s, i), fract(cx), fract(cy))
  return g * step(0, cx) * step(cx, n) * step(0, cy) * step(cy, 1)
}

frame {
  kickE = exp(-trig(0) * 6.5) * step(0.5, vel(0))
  arpE = exp(-trig(4) * 4.5)
  bellE = exp(-trig(5) * 3.0)
  padE = exp(-trig(2) * 2.2)
  wBranch = evtl(brV)
  wSky = evtl(skyV)
  grow = evtl(growV)
  storm = evtl(turmV)
  camZ = evtl(zoomV)
  camA = evtl(spinV)
  warm = evtl(warmV)
  trail = evtl(trailV)
  titleA = evtl(titleV)
}

pixel world {
  # ---------------- one camera for the whole piece: a slow, continuous push-in
  z = camZ * (1 + 0.035 * padE - 0.030 * kickE + 0.030 * sin(time * 0.21))
  rc = rot(u + 0.03 * sin(time * 0.11), v + 0.02 * sin(time * 0.07), camA + 0.10 * storm * sin(time * 0.7))
  cx = rc * z
  cy = r1 * z

  # ---------------- A. the seed: a cold nucleus with a breathing shell
  rs = len(cx, cy)
  R = 0.30 + 0.045 * sin(time * 0.85) + 0.020 * kickE
  lump = fbm(cx * 2.4 + time * 0.09, cy * 2.4 - time * 0.06, 3)
  Rs = R + 0.07 * (lump - 0.5)
  shell = exp(-abs(rs - Rs) * 16)
  sang = atan2(cy, cx)
  swirl = fbm(sang * 1.7 + time * 0.10, rs * 4.6 - time * 0.22, 3)
  seed = shell * (0.75 + 0.35 * sin(time * 1.6 + rs * 18)) + exp(-rs * 3.0) * (0.45 + 0.75 * swirl) * 0.60

  # ---------------- B. the growth: veins unfolding from the nucleus
  wn = fbm(cx * 1.5 + time * 0.045, cy * 1.5 - time * 0.035, 3)
  bx = cx + (wn - 0.5) * (0.30 + 0.55 * storm)
  by = cy + (wn - 0.5) * (0.30 + 0.55 * storm)
  # the storm shears the network
  bx = bx + storm * (0.055 * sin(by * 7.0 - time * 2.6 + wn * 6.0) + 0.018 * sin(by * 23.0 + time * 5.0))
  by = by + storm * 0.045 * sin(bx * 6.0 + time * 2.1)

  dv = vor(bx * 2.4 + 7.0, by * 2.4 - 3.0)
  id = r1
  vein = exp(-(r2 - dv) * 22)
  # half the veins tear away in the storm
  vein = vein * (1 - 0.55 * storm * step(0.5, sin(id * 31.0 + time * 3.0)))
  dv2 = vor(bx * 6.5 - 2.0 + wn, by * 6.5 + 5.0 - wn)
  vein = vein + exp(-(r2 - dv2) * 26) * 0.38

  rr = len(bx, by)
  inside = 1 - smooth(grow, grow + 0.30, rr)
  front = exp(-abs(rr - grow) * 9) * (0.35 + 0.35 * sin(time * 2.0))
  branch = (vein * inside * 1.30 + front) * (0.60 + 0.45 * bellE)
  branch = branch * (1 + 0.35 * storm * kickE)

  # the heart of the seed survives inside every form
  heart = exp(-rs * 5.5) * (0.30 + 0.40 * padE)

  # ---------------- C. the dawn: the same matter becomes a sunrise
  hy = cy + 0.06 * sin(cx * 1.4 + time * 0.10)
  ground = 1 - smooth(-0.65, 0.55, hy)
  sun = exp(-len(cx * 0.50, (cy + 0.30 - 0.10 * wSky) * 1.45) * 2.1)
  band = exp(-abs(cy + 0.26) * 22) * 0.55
  clouds = fbm(cx * 1.7 + time * 0.02, cy * 3.5 - time * 0.03, 4)
  sky = ground * (0.20 + 0.75 * clouds) * 0.75 + sun * 0.72 + band * 0.30

  # ---------------- blend the three states: intensities first, then colour
  val = mix(seed, branch, wBranch)
  val = mix(val, sky, wSky)
  val = val + heart * (1 - 0.85 * wSky)
  val = clamp(val, 0, 1.8) + exp(-rs * 1.35) * 0.06 * (1 - wSky)

  qr = val * 0.55
  qg = val * 0.85
  qb = val * 1.12
  er = val * (0.22 + 0.90 * warm)
  eg = val * (0.88 - 0.30 * warm)
  eb = val * (1.08 - 0.88 * warm)
  kr = val * (0.62 + 0.48 * warm)
  kg = val * (0.30 + 0.45 * warm)
  kb = val * (0.26 - 0.13 * warm)

  cr = mix(qr, er, wBranch)
  cg = mix(qg, eg, wBranch)
  cb = mix(qb, eb, wBranch)
  cr = mix(cr, kr, wSky)
  cg = mix(cg, kg, wSky)
  cb = mix(cb, kb, wSky)

  # deep background, warming with the story
  rgb(cr + 0.008 + 0.035 * warm, cg + 0.012 + 0.016 * warm, cb + 0.030 + 0.006 * warm)

  # dust motes drifting through the whole journey
  repeat k 6 {
    px = (hash(k * 11.3 + 1.0) - 0.5) * 2.5 * aspect
    py = fract(hash(k * 5.7) + time * (0.010 + 0.020 * hash(k * 3.1))) * 2.2 - 1.1
    d = len(u - px, (v - py) * 0.75)
    sp = 1 - smooth(0, 0.004 + 0.006 * hash(k * 7.7), d)
    hb = 0.45 + 0.55 * sin(time * (2 + 2 * hash(k * 9.3)) + k * 2.1)
    cadd(sp * hb * 0.9, sp * hb * 0.8, sp * hb * 0.65)
  }

  # ---------------- feedback: everything leaves a little light behind
  cprevz(0.5, 0.5, 1.003 + 0.012 * storm, 0.002 + 0.006 * storm, trail)

  # the name arrives with the morning
  lg = titleline(tlabel, 0.34, 0.16) * titleA
  lg = lg * (0.80 + 0.20 * sin(time * 3.0 + u * 6.0))
  cadd(lg * 0.95, lg * 0.78, lg * 0.55)
}

post {
  # bloom, a touch of chromatic split on the kick, grain and a soft vignette
  cr = tap(0, 0)
  cg = r1
  cb = r2
  sh = floor(3 * kickE)
  ar = tap(-1 - sh, 0)
  ab = tap(1 + sh, 0)
  bl = (tap(-2, 0) + tap(2, 0) + tap(0, 2) + tap(0, -2) + tap(-3, 3) + tap(3, -3) + tap(-3, -3) + tap(3, 3)) * 0.125
  rgb(cr * 0.94 + ar * 0.16 + bl * 0.36,
      cg * 0.96 + bl * 0.29,
      cb * 0.94 + ab * 0.18 + bl * 0.38)
  du = (hash(x * w * 0.31 + y * h * 0.67 + frame * 5.7) - 0.5) * 0.038
  cadd(du, du, du * 1.1)
  d = len(u, v)
  cmul(max(0.50, 1 - 0.28 * d))
  cadd(0.03 * kickE, 0.012 * kickE, 0.004 * kickE)
}
