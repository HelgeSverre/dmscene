# @model DeepSeek V4.1 Flash
# @collection Written by the models
# @music one continuous arc: sub drone and heartbeat, then bass pulse, arps and hats, a filter-swell dissonant breakdown, a full B♭/F climax, and a final Picardy-third D-major chord with bells ringing to the last frame
# @visual a cold seed of light unfolds into a vein membrane, shears into violet tendrils around a surviving heart, then dissolves into a sunrise and the title; one pixel program blended by timeline-ramped uniforms, a shared camera transform and cprevz feedback, so every state morphs into the next with no cuts
# @duration 50
# morrow.dmt - a seed of light in the dark: it grows, storms, and becomes the morning.
# One continuous field: the seed, its veins and the dawn are mixed by timeline ramps,
# never cut. 96 BPM, 20 bars of 16 rows = 50 seconds.
title MORROW
song bpm=96 speed=6 rpb=4 channels=8 loop=18 volume=0.55
order 0 1 1 2 2 3 4 5 5 4 6 6 7 7 8 8 7 8 9 9
pan 0.5 0.5 0.5 0.46 0.62 0.40 0.56 0.5

text tlabel "MORROW"

timeline {
  0:00  brV=0.00 skyV=0.00 growV=0.06 turmV=0.00 zoomV=1.60 spinV=0.00 warmV=0.00 trailV=0.00 titleV=0
  1:00  growV=0.20 warmV=0.03
  2:00  growV=0.34 brV=0.25
  3:00  growV=0.48 brV=0.55 warmV=0.07 zoomV=1.45
  4:00  growV=0.62 brV=0.80
  5:00  growV=0.78 brV=0.95 zoomV=1.30 warmV=0.12
  6:00  growV=0.92 brV=1.00
  7:00  growV=1.05 zoomV=1.15 warmV=0.18
  8:00  growV=1.18 turmV=0.10
  9:00  growV=1.30 turmV=0.18 zoomV=1.05 spinV=0.10
  10:00 turmV=0.40 warmV=0.25 trailV=0.15 spinV=0.18 zoomV=0.95
  11:00 turmV=0.85 trailV=0.30 spinV=0.40 zoomV=0.82 warmV=0.32
  12:00 turmV=1.00 spinV=0.60 zoomV=0.72 trailV=0.40 warmV=0.40
  13:00 turmV=1.05 spinV=0.85 trailV=0.38 warmV=0.48
  14:00 turmV=0.95 spinV=1.05 zoomV=0.68
  15:00 turmV=0.80 spinV=1.20 trailV=0.35 warmV=0.56
  16:00 turmV=0.60 spinV=1.30 zoomV=0.80
  17:00 skyV=0.20 turmV=0.40 spinV=1.20 warmV=0.68 trailV=0.30
  18:00 skyV=0.60 turmV=0.15 spinV=0.45 warmV=0.80 zoomV=1.00 trailV=0.28
  18:08 titleV=0
  19:00 skyV=1.00 turmV=0.00 brV=0.10 spinV=0.00 warmV=0.95 zoomV=1.05 trailV=0.22 titleV=0.90
}

# ------------------------------------------------------------------ instruments
inst sub {
  e = env(0.06, 0.7, 0.85, 1.0)
  s = sin(ph * tau) * 0.9 + sin(ph * tau * 2) * 0.07
  out(dist(s * e, 1.1) * 0.5)
}
inst pad nna=continue {
  e = env(0.9, 1.4, 0.80, 2.6)
  s = usaw(freq, 0.16) + usaw(freq * 1.5, 0.11) * 0.30 + sin(ph * tau * 0.5) * 0.18
  s = svf(s, 300 + 900 * e * (0.35 + 0.65 * mp1) + 180 * sin(t * 0.31), 0.15)
  out(s * e * 0.17)
}
inst kick {
  f = 43 + 400 * exp(-t * 28)
  $p = $p + f / sr
  body = sin($p * tau) * exp(-t * 5.2)
  click = hp(noise(), 1800) * exp(-t * 95) * 0.22
  out(dist(body * 1.55 + click, 1.22) * 0.74)
}
inst bass {
  e = env(0.008, 0.13, 0.55, 0.14)
  s = sin(ph * tau) * 0.8 + saw(ph) * 0.34 + sqr(ph * 0.5, 0.42) * 0.18
  s = svf(s, 190 + 850 * e, 0.35)
  out(dist(s * e, 1.3) * 0.42)
}
inst arp {
  e = exp(-t * 2.8)
  m = sin(ph * tau * 2.0 + 0.9 * sin(t * 5.5)) * exp(-t * 4.5) * 0.9
  out((sin(ph * tau + m * 1.2) + 0.25 * sin(ph * tau * 2.02)) * e * 0.21)
}
inst bell {
  e = exp(-t * 2.1)
  m = sin(ph * tau * 3.01 + 0.8 * sin(t * 6.0)) * exp(-t * 4.2)
  out((sin(ph * tau + m * 1.3) + 0.3 * sin(ph * tau * 2.01)) * e * 0.22)
}
inst hat {
  out(hp(noise(), 7200) * exp(-t * (48 + 80 * (1 - vel))) * 0.20)
}
inst air {
  # filtered noise swell; the Sxx parameter opens the filter
  e = env(0.8, 1.5, 0.72, 2.2)
  s = svf(noise(), 240 + 4300 * p0 * e + 160 * sin(t * 0.6), 0.62)
  out(s * e * 0.24)
}

master {
  dl = dly(l, 0.42, 0.42)
  dr = dly(r, 0.56, 0.42)
  w = verb(l * 0.5 + r * 0.5, 0.86, 0.40)
  out(dist(l + dr * 0.24 + w * 0.22, 1.06), dist(r + dl * 0.24 + w * 0.22, 1.06))
}

