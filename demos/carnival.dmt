# @model DeepSeek V4.1 Flash
# @collection Written by the models
# @music 3/4 waltz: tuba, chord-generating calliope, music-box FM, theremin, soft kick, brushes and harmonium drone through modulated delays and Freeverb
# @visual a night fairground reflected in a wet plaza under a moon with a face: tents, a Ferris wheel and lantern strings, then a match cut into a cracked plaster mask with a tiny fair inside its eyes, a widening grin and a tear, then back to the fair for the confetti finale and title; scale=2 dither=1
# @duration 36
# carnival.dmt - a waltz for a fairground that is a little too quiet.
# A wide shot of a lantern-lit carnival under a moon with a painted face,
# a match cut into that face during the bridge, then back for the last dance.
title CARNIVAL
song bpm=120 speed=6 rpb=4 channels=7 loop=0 volume=0.55 scale=2 dither=1
order 0 1 2 3 4 5 6 2 3 4 5 7 7 8 8 9 9 10 11 9 10 11 12 13
pan 0.50 0.46 0.58 0.40 0.50 0.62 0.50

text ttitle "CARNIVAL"

# ------------------------------------------------------------------ instruments
# a soft tuba for the oom of the waltz
inst tuba {
  e = env(0.004, 0.10, 0.45, 0.14)
  s = sin(ph * tau) * 0.95 + tri(ph * 2.0) * 0.15 + saw(ph) * 0.18
  s = lp(s, 180 + 700 * e * e)
  out(dist(s * e * 1.2, 1.4) * 0.52)
}
# steam calliope: root + third (p0 picks major) + fifth, slightly sharp
inst calliope {
  e = env(0.018, 0.09, 0.55, 0.16)
  third = 1.1892 + 0.0702 * p0
  s = usaw(freq, 0.075) * 0.55
  s = s + usaw(freq * third, 0.095) * 0.34
  s = s + usaw(freq * 1.4983, 0.12) * 0.28
  s = s + sin(ph * tau + 0.06 * sin(t * 5.1)) * 0.40
  s = svf(s, 380 + 1600 * e + 260 * sin(t * 7.3), 0.22)
  s = s * (0.82 + 0.18 * sin(t * tau * 6.2))
  out(dist(s * e * 1.1, 1.5) * 0.24)
}
# a music box with a worn comb
inst musicbox {
  e = exp(-t * 2.4)
  m = sin(ph * tau * 3.01 + 0.5 * sin(t * 2.7)) * exp(-t * 4.2)
  s = sin(ph * tau + m * 1.25) + 0.30 * sin(ph * tau * 2.005)
  click = hp(noise(), 3800) * exp(-t * 160) * 0.18
  out((s * e + click) * 0.22)
}
# the thing that sings in the bridge
inst theremin nna=continue {
  e = env(0.28, 0.35, 0.80, 0.45)
  v = 0.22 * sin(t * 5.7) + 0.08 * sin(t * 2.1)
  s = sin(ph * tau + v) + 0.16 * sin(ph * tau * 2.002 - v * 1.4)
  s = svf(s, 1100 + 900 * e, 0.40)
  out(s * e * 0.20)
}
inst kick {
  f = 52 + 220 * exp(-t * 28)
  $p = $p + f / sr
  body = sin($p * tau) * exp(-t * 8)
  thump = sin($p * tau * 2.01) * exp(-t * 22) * 0.20
  click = lp(noise(), 1500) * exp(-t * 110) * 0.18
  out(dist((body + thump + click) * 1.35, 1.25) * 0.62)
}
# brushes on a snare, played as a whisper
inst brush {
  e = exp(-t * (7 + 5 * (1 - vel)))
  n = svf(noise(), 1800 + 2400 * vel, 0.5)
  body = sin(tau * 197 * t) * exp(-t * 26) * 0.18
  out((n * 0.9 + body) * e * 0.30)
}
inst chime {
  e = exp(-t * 1.35)
  m = sin(ph * tau * 2.76 + 0.4) * 2.0 * exp(-t * 2.0)
  s = sin(ph * tau + m) + 0.28 * sin(ph * tau * 3.01)
  out(s * e * 0.17)
}
# a low harmonium drone that never quite settles
inst drone nna=continue {
  e = env(1.2, 1.4, 0.80, 1.8)
  s = usaw(freq * 0.5, 0.22) * 0.35 + sin(ph * tau * 0.5) * 0.55 + sin(ph * tau) * 0.22
  s = svf(s, 150 + 180 * sin(t * 0.17) + 260 * p0, 0.22)
  out(s * e * 0.20)
}

master {
  # short modulated delays: a seasick chorus on the whole fairground
  cl = dly(l, 0.013 + 0.0035 * sin(t * 0.63), 0.0)
  cr = dly(r, 0.017 + 0.0040 * sin(t * 0.71 + 1.7), 0.0)
  dl = dly(l + cr * 0.25, 0.371, 0.40)
  dr = dly(r + cl * 0.25, 0.487, 0.40)
  w = verb(l * 0.5 + r * 0.5, 0.84, 0.50)
  out(dist(l * 0.90 + cl * 0.22 + dr * 0.18 + w * 0.18, 1.10),
      dist(r * 0.90 + cr * 0.22 + dl * 0.18 + w * 0.18, 1.10))
}

