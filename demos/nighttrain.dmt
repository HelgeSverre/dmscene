}

pattern 4 rows=16 {
  . | . | G-1 3 34 | G-2 4 2E
  .
  .
  .
  . | . | . | . | G-4 5 20
  .
  . | C-6 2 10
  .
  .
  .
  . | C-5 2 1E
  . | C-6 2 16
