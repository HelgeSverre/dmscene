# nighttrain.dmt - a nearly empty platform at 4 a.m.  One person waits.
# The train is late.  Fluorescent tubes buzz (one of them dying, and you can
# hear which one), a vending machine hums cold light onto wet concrete, rain
# runs down the shelter glass between us and the scene.  The split-flap board
# settles on NIGHTTRAIN / DELAYED.  At the very end a light grows down the
# track - maybe the train, maybe not.
#
# One continuous fixed wide shot, one-point perspective down the platform.
# Audio: 120 BPM downtempo in D minor - mains hum + tube buzz (flicker formula
# shared sample-for-sample with the video), rain, soft kick, sub bass, chord
# pad, FM bells, distant diminished horn, and a rising rumble driven by the
# same clock as the headlight glow.  scale=2 keeps it filmic and fast.

title NIGHTTRAIN
song bpm=120 speed=6 rpb=4 channels=8 loop=0 volume=0.62 scale=2 dither=1
order 0 1 2 3 2 3 4 1 2 3 4 5 6 7 8
pan 0.50 0.55 0.50 0.45 0.50 0.62 0.50 0.55

text TITLE "NIGHTTRAIN"
text SUB "DELAYED"

timeline {
  0:00 rain=0.55 sig=0 hl=0
  3:00 rain=0.90
  6:00 rain=0.50
  9:00 rain=0.85
  10:00 sig=0
  10:10 sig=1
  11:00 hl=0
  11:08 hl=0.06
  12:00 rain=0.60
  14:00 rain=0.45
  14:08 hl=1
}

# ------------------------------------------------------------------ audio
# 1 kick  2 perc(click/plink)  3 bass  4 pad  5 bell  6 hum  7 rain  8 rumble  9 horn

inst kick {
  f = 42 + 190 * exp(-t * 20)
  $p = $p + f / sr
  body = sin($p * tau) * exp(-t * 4.2)
  air = lp(noise(), 300) * exp(-t * 30) * 0.3
  out(dist(body * 1.9 + air, 1.35) * 0.60)
}

inst perc {
  # vol >= 0x14: split-flap board click.  quieter: a droplet plinking off the roof.
  isC = step(0.30, vel)
  cn = hp(noise(), 3600) * exp(-t * 95) + sin(tau * 2100 * t) * exp(-t * 140) * 0.6
  pe = exp(-t * 16)
  pm = sin(ph * tau * 2.71) * 1.8 * exp(-t * 9)
  pl = sin(ph * tau + pm) * pe
  out(mix(pl * 0.9, cn * 1.7, isC) * 0.16)
}

inst bass {
  e = env(0.015, 0.45, 0.55, 0.30)
  s = sin(ph * tau) * 0.9
  s = s + svf(bsaw(ph, freq), 150 + 260 * e, 0.35) * 0.45
  out(dist(s, 1.2) * e * 0.50)
}

inst pad nna=continue {
  # one finger, whole minor triad
  e = env(1.1, 1.6, 0.80, 2.4)
  s = bsaw(ph, freq) * 0.30 + bsaw(ph + 0.0013 * t, freq) * 0.26
  s = s + bsaw(ph * 1.18921, freq * 1.18921) * 0.22
  s = s + bsaw(ph * 1.49831, freq * 1.49831) * 0.22
  s = s + sin(ph * tau * 2) * 0.10
  s = svf(s, 430 + 480 * e + 170 * sin(t * 0.29), 0.30)
  out(s * e * 0.15)
}

inst bell nna=continue {
  e = exp(-t * 2.4)
  mi = 3.2 * exp(-t * 2.9)
  m = sin(ph * tau * 3.007) * mi
  s = sin(ph * tau + m) + sin(ph * tau * 2.003 + m * 0.4) * 0.30
  out(s * e * 0.20)
}

inst hum {
  # mains hum from the vending machine + the harsh buzz of the dying tube.
  # the flicker formula is identical to the one in `frame`, so the tube you
  # see stuttering is the one you hear.
  e = env(1.2, 1.0, 1.0, 2.0)
  fl = 0.55 + 0.45 * step(0.28, hash(floor(t * 17) * 0.317))
  fl = fl * step(0.10, hash(floor(t * 17) * 1.71 + 7.3))
  fl = fl * (0.9 + 0.1 * sin(t * 51))
  s = osc(60 * t) * 0.5 + osc(120 * t) * 0.20 + osc(180 * t) * 0.07
  bz = hp(noise(), 2400) * 0.5
  out((s * (0.55 + 0.45 * fl) * 0.5 + bz * fl * 0.35) * e * 0.085)
}

inst rain {
  e = env(1.5, 1.0, 1.0, 2.5)
  n = svf(noise(), 2600 + 900 * sin(t * 0.23), 0.12)
  body = r2 * 1.2 + n * 0.3
  low = lp(noise(), 110) * 0.5
  out((body * (0.75 + 0.25 * sin(t * 0.13 + 1)) * 0.5 + low * 0.35) * e * 0.16)
}

inst rumble {
  amp = min(t / 6.5, 1)
  amp = amp * amp
  n = lp(noise(), 45 + 300 * amp)
  sub = osc(30 * t) * 0.8 + osc(45 * t) * 0.3
  out(dist((n * 0.9 + sub * 0.7) * (0.3 + amp), 1.25) * amp * 0.55)
}

inst horn {
  # distant two-note-plus-tritone horn, far away and low-passed
  e = env(0.8, 0.5, 0.75, 1.6)
  tr = 0.88 + 0.12 * sin(t * 5.3)
  s = osc(ph) + osc(ph * 1.18921) * 0.8 + osc(ph * 1.41421) * 0.7
  s = lp(s * 0.5, 750)
  out(s * e * tr * 0.20)
}

chan 3 {
  w = verb(x, 0.78, 0.45)
  out(x * 0.7 + w * 0.55)
}
chan 4 {
  d = dly(x, 0.375, 0.40)
  w = verb(x * 0.6 + d * 0.3, 0.6, 0.5)
  out(x * 0.8 + d * 0.30 + w * 0.25)
}
master {
  dl = dly(l, 0.29, 0.28)
  dr = dly(r, 0.43, 0.28)
  vl = verb(l + dr * 0.15, 0.62, 0.5)
  vr = verb(r + dl * 0.15, 0.62, 0.5)
  out(dist(l * 0.85 + dr * 0.10 + vl * 0.13, 1.12), dist(r * 0.85 + dl * 0.10 + vr * 0.13, 1.12))
}

# ------------------------------------------------------------------ score
# channels: 0 kick | 1 perc | 2 bass | 3 pad | 4 bell/horn | 5 hum | 6 rain | 7 rumble
# one pattern = one bar = 2 s.  arc: Dm Dm Bb F / Bb F Gm lull / repeat / Dm Bb F Dm finale.

pattern 0 rows=16 {
  . | . | . | D-3 4 34 | . | C-2 6 1C | C-2 7 24
  .
  .
  .
  .
  .
  .
  .
  .
  . | E-6 2 0C
  .
  .
  .
  .
  .
  .
}

pattern 1 rows=16 {
  C-2 1 2E | . | D-2 3 38 | D-3 4 30
  .
  . | C-5 2 16
  . | C-6 2 12
  . | C-5 2 14 | . | F-5 5 2A
  . | C-6 2 18
  .
  . | C-5 2 12
  . | D-6 2 16 | A-1 3 2E
  . | C-6 2 12
  . | . | . | . | E-5 5 26
  . | C-5 2 14
  .
  .
  . | . | . | . | D-5 5 22
  .
}

