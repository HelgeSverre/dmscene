# ------------------------------------------------------------------ visuals
uniform sig ringA ap wavA tilt titleA hudA climax kickE pingE hue lock

fn ringd(px, py, cx, cy, rr, sq, tw) {
  q  = rot(px - cx, py - cy, tw)
  qy = r1 * sq
  return len(q, qy) - rr
}
fn textline(s, ox, oy, hgt, sp) {
  cw = hgt * 0.47 * (1 + sp)
  cx = (u - ox) / cw
  cy = (oy - v) / hgt
  i  = floor(cx)
  return glyph(str(s, i), fract(cx), fract(cy)) * step(0, cx) * step(cx, strlen(s)) * step(0, cy) * step(cy, 1)
}

frame {
  sig    = evtl(bsig)
  ringA  = evtl(bring)
  ap     = evtl(bap)
  wavA   = evtl(bwav)
  tilt   = evtl(btilt) + 0.015 * sin(beat * 0.07)
  titleA = evtl(bttl)
  hudA   = evtl(bhud)
  lock   = evtl(block)
  climax = evtl(bclim)
  kickE  = exp(-trig(0) * 6)
  pingE  = exp(-trig(1) * 1.7)
  hue    = 0.5 + 0.5 * sin(time * 0.06)
}

pixel {
  # ---------------- camera: a slow dolly toward the ring
  zm  = 1 + 0.16 * climax + 0.018 * sin(beat * 0.05)
  cx0 = 0.020 * sin(beat * 0.031)
  cy0 = 0.12
  roll = 0.008 * sin(beat * 0.037) + 0.002 * sin(beat * 0.11)
  rl  = rot(u, v, roll)
  px  = rl * zm + cx0 * (1 - zm)
  py  = (r1 - cy0) * zm + cy0
  gy  = (-0.34 - cy0) * zm + cy0        # world horizon, transformed

  # ---------------- sky: dark cloud and a sparse star grid
  nb = fbm(px * 1.05 + 4.0, py * 1.05 - 2.0, 3)
  hs = hash(floor(px * 48 + 11.0) * 1.73 + floor(py * 48 + 7.0) * 97.31)
  h2 = hash(hs * 37.0 + 5.0)
  h3 = hash(hs * 91.0 + 17.0)
  sx = fract(px * 48 + 11.0) - 0.5 - (h2 - 0.5) * 0.62
  sy = fract(py * 48 +  7.0) - 0.5 - (h3 - 0.5) * 0.62
  star = step(0.972, hs) * exp(-(sx * sx + sy * sy) * 95) * (0.20 + 0.80 * h2)
  star = star * (0.60 + 0.40 * sin(time * 1.6 + hs * 60))

  # soft airglow lifting the top of the sky
  aur = exp(-(py - 0.95) * (py - 0.95) * 2.4) * (0.20 + 0.35 * ringA)

  # dust motes hanging in the beam
  mxc = fract(px * 40 + 3.0) - 0.5
  myc = fract(py * 40 + 1.0 - time * 0.06) - 0.5
  mh  = hash(floor(px * 40 + 3.0) * 3.7 + floor(py * 40 + 1.0 - time * 0.06) * 11.3)
  mote = step(0.984, mh) * exp(-(mxc * mxc + myc * myc) * 80) * exp(-abs(px) * 4.5)

  # ---------------- the ring: a machined band, edge lights and struts
  RR = 0.40 + 0.004 * sin(time * 0.9)
  q  = rot(px, py - 0.16, tilt)
  qx = q
  qy = r1 * (0.95 + 0.02 * sin(time * 0.37))
  rad = len(qx, qy)
  ang = atan2(qy, qx)
  d   = rad - RR
  band = smooth(-0.018, -0.007, d) * (1 - smooth(0.007, 0.018, d))
  e1   = 1 - smooth(0.0010, 0.0032, abs(d + 0.011))
  e2   = 1 - smooth(0.0010, 0.0032, abs(d - 0.011))
  edge = e1 + e2
  arb  = abs(fract(ang * 8 / tau + 0.5) - 0.5) * (tau / 8) * rad
  spar = exp(-arb * arb * 3200) * smooth(RR * 0.60, RR * 0.65, rad) * (1 - smooth(RR * 0.94, RR * 0.99, rad))
  tic  = abs(fract(ang * 24 / tau + 0.5) - 0.5) * (tau / 24) * rad
  crown = exp(-tic * tic * 2400) * smooth(RR * 1.03, RR * 1.06, rad) * (1 - smooth(RR * 1.09, RR * 1.12, rad))
  scan = 0.62 + 0.38 * sin(ang - time * 0.8)
  ring = (band * 0.55 + edge * 1.15 + spar * 0.55 + crown * 0.40) * scan * (0.10 + 0.90 * ringA)
  glow = exp(-abs(d) * 13) * (0.10 + 0.18 * ap)

  # ---------------- the aperture: a disc of standing interference
  apR   = RR * (0.52 + 0.16 * ap)
  disc  = 1 - smooth(apR - 0.004, apR + 0.002, rad)
  aring = (1 - smooth(0.0012, 0.0036, abs(rad - apR))) * (0.10 + 0.90 * ap)
  c1  = 0.020 * sin(time * 0.6)
  a1  = len(qx - c1, qy)
  a2  = len(qx + c1, qy + 0.004)
  mo  = (0.5 + 0.5 * sin(a1 * 86 - time * 2.9)) * (0.5 + 0.5 * sin(a2 * 86 + time * 2.2))
  swp = 0.5 + 0.5 * sin(ang * 5 + rad * 30 - time * 1.4)
  holo = disc * ap * (mo * 0.70 + swp * 0.30)

  # rays thrown outward while the aperture is open
  raya = abs(fract(ang * 12 / tau + 0.5) - 0.5) * (tau / 12) * rad
  ray  = exp(-raya * raya * 700) * smooth(RR * 1.04, RR * 1.55, rad) * (1 - smooth(1.5, 2.5, rad))
  ray  = ray * ap * (0.05 + 0.04 * sin(ang * 3 + time * 0.5))
  flh  = exp(-abs(py - 0.16) * 320) * exp(-abs(px) * 1.15) * (0.02 + 0.09 * ap)
  flv  = exp(-abs(px) * 340) * exp(-abs(py - 0.16) * 2.2) * 0.05 * ap

  # ---------------- the beam: a thread of warm light from above
  bw    = 0.003 + 0.009 * (1 - sig) + 0.0015 * sin(time * 8)
  bcore = exp(-abs(px) / bw)
  bglow = exp(-abs(px) * 11)
  bmask = step(py, 0.175) * (0.55 + 0.55 * sig)
  flick = 0.86 + 0.10 * sin(time * 63) + 0.04 * sin(time * 141)
  beam  = (bcore * (0.40 + 0.95 * sig) + bglow * 0.07 * sig) * bmask * flick
  hot   = exp(-rad * rad * 1400) * ap * (0.50 + 0.90 * sig)
  blaze = exp(-rad * rad * 240) * ap * ap * (0.30 + 0.35 * sig)

  # ---------------- carrier trace: an oscilloscope across the sky
  amp = 0.006 + 0.030 * sig + 0.018 * kickE
  ty  = 0.50 + 0.042 * sin(px * 1.9 + time * 0.7) + 0.022 * sin(px * 4.3 - time * 1.1)
  ty  = ty + amp * (0.55 * sin(px * 16 - time * 8.0) + 0.28 * sin(px * 29 + time * 12.0))
  tl  = exp(-abs(py - ty) * 620) * (0.22 + 0.62 * sig)
  tg  = exp(-abs(py - ty) * 40) * 0.07 * sig

  # a second receiver far off on the left, only a spark at this distance
  mrd  = len(px + 0.98, py + 0.075) - 0.040
  mini = (1 - smooth(0.0014, 0.0040, abs(mrd))) * (0.16 + 0.55 * ringA)

  # ---------------- water
  wm   = step(py, gy)
  rfy  = 2 * gy - py
  wob  = 0.0035 * sin(py * 300 + time * 2.6) + 0.005 * (fbm(px * 2.6, py * 70.0, 2) - 0.5)
  rfx  = px + wob
  rq   = rot(rfx, rfy - 0.16, tilt)
  rqx  = rq
  rqy  = r1 * 0.95
  rrad = len(rqx, rqy)
  rd   = rrad - RR
  rip  = 0.10 + 0.90 * smooth(0.22, 0.80, fbm(px * 9.0, (gy - py) * 34.0 + time * 0.8, 2))
  rband = smooth(-0.030, -0.010, rd) * (1 - smooth(0.010, 0.030, rd))
  rline = (1 - smooth(0.0025, 0.0110, abs(rd))) * rip
  fade  = exp(-max(0, gy - py) * 2.1)

  dys = (gy - py) * 3.4
  wd  = len(px, dys)
  wfa = exp(-abs(wd - fract(time * 0.14) * 2.8) * 44)
  wfb = exp(-abs(wd - fract(time * 0.14 + 0.5) * 2.8) * 44)
  wf  = (wfa + wfb) * wavA * fade * wm * 0.10

  wtex   = fbm(px * 2.4 + 2.0, py * 55.0 + time * 0.03, 2)
  streak = exp(-abs(sin((gy - py) * 62 + wtex * 4.0)) * 12) * 0.045 * fade * wm
  fog    = exp(-abs(py - gy) * 8) * (0.025 + 0.05 * ringA)

  # ---------------- assemble
  baseR = 0.0050 + 0.014 * nb
  baseG = 0.0080 + 0.023 * nb
  baseB = 0.0150 + 0.045 * nb
  baseR = mix(baseR, 0.0030 + 0.010 * wtex, wm)
  baseG = mix(baseG, 0.0070 + 0.026 * wtex, wm)
  baseB = mix(baseB, 0.0170 + 0.050 * wtex, wm)
  vis = (1 - wm) * (1 - disc) * (1 - min(1, edge))

  rgb(baseR + star * 0.70 * vis, baseG + star * 0.78 * vis, baseB + star * 0.90 * vis + fog * 0.10)
  cadd(fog * 0.30, fog * 0.55, fog * 0.80)

  # structure, cold
  cadd(ring * 0.26, ring * 0.62, ring * 0.78)
  cadd(glow * 0.10, glow * 0.30, glow * 0.40)
  cadd(glow * 0.12 * ap, glow * 0.26 * ap, glow * 0.34 * ap)
  cadd(aring * 0.28, aring * 0.62, aring * 0.72)
  cadd(holo * 0.24, holo * 0.62, holo * 0.80)
  cadd(aur * 0.020 * (1 - wm), aur * 0.045 * (1 - wm), aur * 0.11 * (1 - wm))
  cadd(mini * 0.22, mini * 0.55, mini * 0.68)
  cadd(mote * 0.55 * sig, mote * 0.62 * sig, mote * 0.72 * sig)
  cadd(ray * 0.16, ray * 0.34, ray * 0.46)
  cadd(flh * 0.72, flh * 0.62, flh * 0.50)
  cadd(flv * 0.18, flv * 0.26, flv * 0.34)

  # signal, warm
  cadd(beam * 1.00, beam * 0.86, beam * 0.58)
  cadd(hot * 1.00, hot * 0.90, hot * 0.70)
  cadd(blaze * 0.42, blaze * 0.54, blaze * 0.56)
  cadd(tl * 0.60 + tg * 0.50, tl * 0.90 + tg * 0.50, tl * 1.00 + tg * 0.45)

  # reflection
  cadd(rband * 0.07 * fade * ringA, rband * 0.20 * fade * ringA, rband * 0.26 * fade * ringA)
  cadd(rline * 0.13 * fade * ringA, rline * 0.32 * fade * ringA, rline * 0.40 * fade * ringA)
  cadd(beam * wm * fade * 0.18, beam * wm * fade * 0.15, beam * wm * fade * 0.10)
  cadd(wf * 0.28, wf * 0.66, wf * 0.82)
  cadd(streak * 0.30, streak * 0.58, streak * 0.70)

  dd = len(u * 0.62, v)
  cmul(max(0.52, 1 - 0.30 * dd * dd))
}

post {
  # bloom, a ping-driven chromatic split, scanlines, grain, and the type
  bl = tap(-2, 0) + tap(2, 0) + tap(0, -2) + tap(0, 2)
  bl = bl + tap(-1, -1) + tap(1, 1) + tap(-1, 1) + tap(1, -1)
  bl = bl * 0.125
  sh = floor(3 * pingE)
  ar = tap(-2 - sh, 0)
  ab = tap(2 + sh, 1)
  rgb(cget(0) * 0.96 + bl * 0.50 + ar * 0.10,
      cget(1) * 0.98 + bl * 0.56,
      cget(2) * 0.98 + bl * 0.64 + ab * 0.10)

  cmul(1.04)
  gr = (hash(x * w * 0.71 + y * h * 0.37 + frame * 13.7) - 0.5) * 0.028
  cadd(gr, gr, gr)

  # title: the field dims and a wide wordmark takes the frame
  ta = titleA
  cmul(1 - 0.40 * ta)
  t1 = textline(ttl, -0.76, -0.42, 0.42, 0.24)
  tg = textline(ttl, -0.748, -0.414, 0.42, 0.24) + textline(ttl, -0.772, -0.426, 0.42, 0.24)
  tg = tg + textline(ttl, -0.76, -0.400, 0.42, 0.24) + textline(ttl, -0.76, -0.440, 0.42, 0.24)
  cmul(1 - 0.62 * t1 * ta)
  cadd(t1 * ta * 0.80 + tg * ta * 0.14,
       t1 * ta * 0.94 + tg * ta * 0.20,
       t1 * ta * 1.00 + tg * ta * 0.24)
  # a thin rule under the wordmark
  ur = (1 - smooth(0.0008, 0.0022, abs(v + 0.245))) * step(abs(u), 0.86) * ta
  cadd(ur * 0.16, ur * 0.30, ur * 0.36)

  # hud readouts
  ha = hudA
  h1 = textline(hza, -1.48, 0.84, 0.070, 0.10)
  lk = step(0.5, lock)
  h2 = textline(hzb,  0.74, 0.84, 0.070, 0.10) * lk
  h3 = textline(hzc,  0.95, 0.84, 0.070, 0.10) * (1 - lk)
  cadd(h1 * ha * 0.42 + h2 * ha * 0.36 + h3 * ha * 0.34,
       h1 * ha * 0.72 + h2 * ha * 0.66 + h3 * ha * 0.64,
       h1 * ha * 0.80 + h2 * ha * 0.74 + h3 * ha * 0.72)
  # corner ticks that frame the readouts
  tkr = (1 - smooth(0.0008, 0.0020, abs(v - 0.90))) * step(abs(u), 1.52) * ha
  cadd(tkr * 0.12, tkr * 0.24, tkr * 0.30)
}
