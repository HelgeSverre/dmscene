# tidepool.dmt - a tidepool at dusk: caustic water web, pool stones, an anemone,
# tide ripples and drifting feedback. Liquid ambient at 100 bpm, five 8-beat
# sections: Am / F / C / G / Am(full).
title TIDEPOOL
song bpm=100 speed=6 rpb=4 channels=6 loop=0 volume=0.56
order 0 1 2 3 4
pan 0.45 0.5 0.35 0.62 0.70 0.30

palette abyss {
  0.00  0.010 0.030 0.080
  0.18  0.020 0.100 0.240
  0.38  0.030 0.360 0.460
  0.56  0.120 0.700 0.720
  0.70  0.550 0.920 0.850
  0.82  0.980 0.990 0.920
  0.92  0.950 0.450 0.380
  1.00  0.010 0.030 0.080
}
palette coral {
  0.00  0.020 0.010 0.050
  0.28  0.300 0.050 0.180
  0.52  0.800 0.150 0.300
  0.72  0.950 0.550 0.250
  0.88  1.000 0.900 0.600
  1.00  0.020 0.010 0.050
}

# ----------------------------------------------------------------- instruments
# 1 droplet - watery plink that lands sharp and slides home
inst droplet {
  e    = exp(-t * (12 + 18 * (1 - vel)))
  bend = 1 + 0.9 * exp(-t * 26)
  s    = sin(ph * tau * bend)
  atk = hp(noise(), 5000) * exp(-t * 260) * 0.35
  out((s * 0.85 + atk) * e * 0.4)
}

# 2 tide - the slow breathing sub
inst tide {
  e = env(0.02, 0.35, 0.6, 0.25)
  s = sin(ph * tau) * 0.85 + saw(ph) * 0.12 + sin(ph * tau * 2) * 0.1
  s = lp(s, 150 + 900 * e)
  out(s * e * 0.55)
}

# 3 wash - a swell of filtered noise rolling over the pool
inst wash {
  e = env(0.5, 1.4, 0.65, 1.1)
  n = noise()
  f = 260 + 2600 * e + 1500 * p0 + 700 * sin(t * 0.53)
  b = svf(n, f, 0.32)
  out((b * 0.55 + r2 * 0.3) * e * 0.3)
}

# 4 shimmer - a warm detuned pad holding the chord
inst shimmer {
  e = env(0.6, 1.0, 0.75, 1.2)
  a = sin(ph * tau + 0.5 * sin(ph * tau * 0.5 + t * 0.21))
  d = saw(ph + 0.0013 * t) * 0.5 + saw(ph - 0.0011 * t) * 0.5
  s = svf(a * 0.6 + d * 0.35, 520 + 700 * sin(t * 0.24), 0.22)
  out(s * e * 0.24)
}

# 5 bell - two-op FM glint off the water
inst bell {
  i = 1.4 * exp(-t * 3.2)
  s = sin(ph * tau + sin(ph * tau * 2.41) * i)
  s = s + sin(ph * tau * 3.02 + i * 0.5) * exp(-t * 5) * 0.3
  out(s * exp(-t * 2.1) * 0.26)
}

# 6 shell - soft percussion tick
inst shell {
  n = svf(noise(), 5200 + 2000 * exp(-t * 40), 0.5)
  out((n * 0.4 + r2 * 0.4) * exp(-t * 60) * 0.2)
}

master {
  dl = dly(l, 0.45, 0.35)
  dr = dly(r, 0.675, 0.35)
  vl = verb(l + dr * 0.22, 0.70, 0.50)
  vr = verb(r + dl * 0.22, 0.70, 0.50)
  out(dist(l + dr * 0.30 + vl * 0.18, 1.1), dist(r + dl * 0.30 + vr * 0.18, 1.1))
}

