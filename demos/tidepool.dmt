# --------------------------------------------------------------------- visuals
uniform spin washu kickE glintE pipE hueA bloomA
frame {
  pipE   = exp(-trig(0) * 16)
  kickE  = exp(-trig(1) * 5)
  washu  = cenv(2)
  glintE = exp(-trig(4) * 4)
  bloomA = 0.5 + 0.5 * sin(beat * 0.16)
  spin   = beat * 0.023 + 0.12 * sin(beat * 0.048)
  hueA   = beat * 0.011
}

pixel {
  # domain warp: two drifting fbm fields bend the water surface
  f1 = fbm(u * 2.4 + beat * 0.013, v * 2.4 - beat * 0.011, 3)
  f2 = fbm(u * 3.1 - beat * 0.017 + 4.7, v * 3.1 + beat * 0.015, 2)
  wx = u + (f1 - 0.5) * 0.22 * (0.5 + washu)
  wy = v + (f2 - 0.5) * 0.16 * (0.5 + washu) + 0.04 * sin(u * 6 + beat * 0.09)

  rr = polar(wx, wy)
  an = r1

  # caustic web: interference of two ripple fields, bright at zero crossings
  w1 = sin(wx * 11 + beat * 0.24) * sin(wy * 11 - beat * 0.2)
  w2 = sin((wx + wy) * 6.5 + beat * 0.1)
  caust = exp(-abs(w1 + 0.5 * w2) * 5)

  # pool stones: voronoi tiles, dark grout between, id-shaded interiors
  cd  = vor(wx * 4.5 + spin, wy * 4.5 - spin * 0.6)
  cid = r1
  edge  = exp(-cd * 26)
  shade = 0.45 + 0.55 * cid

  # tide ripples radiating outward from the anemone
  rip = exp(-abs(sin(rr * 15 - beat * 0.5)) * 4.2)

  # the anemone: folded tentacle spokes around a pulsing mouth
  tent = exp(-abs(sin(an * 9 + rr * 8 - beat * 0.35)) * 2.0)
  mask = 1 - smooth(0.10, 0.34, rr)
  anem = (tent * 0.7 + exp(-rr * 9) * (1.0 + 2.0 * kickE)) * mask
  anem = anem * (0.5 + 0.4 * glintE + 0.35 * pipE)

  # glints: sparse twinkles scattered over the surface
  hp  = hash(floor(wx * 110) * 3.1 + floor(wy * 110) * 7.7)
  spk = step(0.982, hp) * (0.3 + 0.7 * (0.5 + 0.5 * sin(beat * 7 + hp * 60)) ^ 2)

  tone = rr * 0.24 + hueA + cid * 0.30 + caust * 0.10 + washu * 0.18
  pal(abyss, tone)
  mixpal(coral, tone * 1.1, bloomA * 0.55)

  light = 0.13 + shade * 0.35 + caust * (0.45 + 0.4 * washu)
  light = light + rip * (0.2 + 0.25 * kickE) + edge * 0.25
  light = light + anem + spk * 0.7
  cmul(light * (0.8 + 0.35 * bloomA + 0.25 * kickE))
  cadd(anem * 0.65, caust * (0.10 + 0.25 * pipE) + anem * 0.18, anem * 0.30 + rip * 0.07 * washu)

  # feedback: gentle zoom + rotation smear, like surface drift
  cprevz(0.5, 0.5, 1.003 + 0.010 * kickE + 0.008 * washu, 0.004 + 0.010 * kickE, 0.14 + 0.10 * washu)
  cmul(1 - 0.30 * rr * rr)
}

post {
  # underwater refraction wobble + slight chromatic split, then a soft bloom
  ox = 1.4 * sin(y * 21 + beat * 2.3) * (0.3 + 0.7 * washu)
  sp = 1.1 + 2.0 * glintE
  c  = tap(ox, 0)
  cG = r1
  cB = r2
  tR = tap(ox + sp, 0)
  tB = tap(ox - sp, 0)
  bB = r2
  b1 = tap(2, 2)
  b1g = r1
  b1b = r2
  b2 = tap(-2, 2)
  b2g = r1
  b2b = r2
  b3 = tap(2, -2)
  b3g = r1
  b3b = r2
  b4 = tap(-2, -2)
  b4g = r1
  b4b = r2
  avR = (b1 + b2 + b3 + b4) * 0.25
  avG = (b1g + b2g + b3g + b4g) * 0.25
  avB = (b1b + b2b + b3b + b4b) * 0.25
  kb  = 0.18 + 0.30 * bloomA + 0.2 * glintE
  R = mix(tR, avR, kb)
  G = mix(cG, avG, kb)
  B = mix(mix(cB, bB, 0.8), avB, kb)
  rgb(R, G, B)
  cmul(1 - 0.32 * (u * u + v * v))
}
