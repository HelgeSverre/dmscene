# plasma.dmt - NES-style chiptune over a dithered palette plasma
title PLASMA
song bpm=160 speed=6 rpb=4 channels=4 loop=0 volume=0.75
order 0 0 1 1 2 2 1 3

palette c64 {
  0.00 0.00 0.00 0.00
  0.14 0.00 0.00 0.00
  0.15 0.40 0.00 0.60
  0.29 0.40 0.00 0.60
  0.30 0.00 0.50 1.00
  0.44 0.00 0.50 1.00
  0.45 0.00 1.00 0.60
  0.59 0.00 1.00 0.60
  0.60 1.00 1.00 0.20
  0.74 1.00 1.00 0.20
  0.75 1.00 0.40 0.30
  0.89 1.00 0.40 0.30
  0.90 1.00 1.00 1.00
  1.00 1.00 1.00 1.00
}

inst p50 {
  e = env(0.001, 0.2, 0.4, 0.04)
  out(sqr(ph, 0.5) * e * 0.3)
}
inst p25 {
  e = env(0.001, 0.15, 0.5, 0.04)
  out(sqr(ph, 0.25) * e * 0.28)
}
inst tri {
  out(crush(tri(ph), 8) * 0.55 * env(0.001, 0.05, 1.0, 0.02))
}
inst dkick {
  f = 80 + 600 * exp(-t * 70)
  $p = $p + f / sr
  out(crush(tri($p), 8) * exp(-t * 18) * 0.7)
}
inst dsnare {
  out(crush(noise(), 3) * exp(-t * 22) * 0.45)
}
inst dhat {
  out(crush(noise(), 2) * exp(-t * 90) * 0.2)
}

# channels: 0 pulse lead  1 pulse harmony  2 triangle bass  3 drums
pattern 0 rows=16 {
  E-5 1 36     | C-4 2 24 | C-2 3 40 | C-3 4 40
  .            | .        | .        | C-6 6 20
  E-5 1 30     | .        | C-3 3 .  | C-6 6 20
  .            | .        | .        | C-6 6 20
  .            | E-4 2 24 | C-2 3 .  | C-5 5 36
  E-5 1 36     | .        | .        | C-6 6 20
  .            | .        | C-3 3 .  | C-6 6 20
  C-5 1 36     | .        | .        | C-6 6 20
  .            | G-4 2 24 | C-2 3 .  | C-3 4 40
  E-5 1 36     | .        | .        | C-6 6 20
  .            | .        | C-3 3 .  | C-6 6 20
  .            | .        | .        | C-6 6 20
  G-5 1 38     | C-5 2 24 | G-2 3 .  | C-5 5 36
  .            | .        | .        | C-6 6 20
  .            | .        | G-2 3 .  | C-6 6 20
  G-4 1 36     | .        | .        | C-6 6 20
}
pattern 1 rows=16 {
  C-5 1 36     | G-3 2 24 | G-1 3 40 | C-3 4 40
  .            | .        | .        | C-6 6 20
  .            | .        | G-2 3 .  | C-6 6 20
  G-4 1 30     | .        | .        | C-6 6 20
  .            | D-4 2 24 | G-1 3 .  | C-5 5 36
  E-4 1 32     | .        | .        | C-6 6 20
  .            | .        | G-2 3 .  | C-6 6 20
  A-4 1 36     | .        | .        | C-6 6 20
  .            | F-4 2 24 | F-1 3 .  | C-3 4 40
  B-4 1 34     | .        | .        | C-6 6 20
  .            | .        | F-2 3 .  | C-6 6 20
  A#4 1 30     | .        | .        | C-6 6 20
  A-4 1 36     | A-4 2 24 | F-1 3 .  | C-5 5 36
  .            | .        | .        | C-6 6 20
  G-4 1 32     | .        | F-2 3 .  | C-5 5 24
  F-4 1 30     | .        | .        | C-5 5 30
}
pattern 2 rows=16 {
  E-5 1 36 047 | C-4 2 24 | A-1 3 40 | C-3 4 40
  .            | .        | .        | C-6 6 20
  .            | .        | A-2 3 .  | C-6 6 20
  .            | .        | .        | C-6 6 20
  D-5 1 36 037 | E-4 2 24 | A-1 3 .  | C-5 5 36
  .            | .        | .        | C-6 6 20
  .            | .        | A-2 3 .  | C-6 6 20
  .            | .        | .        | C-6 6 20
  C-5 1 36 047 | F-4 2 24 | F-1 3 .  | C-3 4 40
  .            | .        | .        | C-6 6 20
  .            | .        | F-2 3 .  | C-6 6 20
  .            | .        | .        | C-6 6 20
  G-5 1 38 047 | G-4 2 24 | G-1 3 .  | C-5 5 36
  .            | .        | .        | C-6 6 20
  B-5 1 34     | .        | G-2 3 .  | C-6 6 20
  D-6 1 34     | .        | .        | C-6 6 20
}
pattern 3 rows=16 {
  C-6 1 38     | E-4 2 24 | C-2 3 40 | C-3 4 40
  .            | .        | .        | C-6 6 20
  B-5 1 34     | .        | C-3 3 .  | C-6 6 20
  .            | .        | .        | C-6 6 20
  A-5 1 36     | F-4 2 24 | F-1 3 .  | C-5 5 36
  .            | .        | .        | C-6 6 20
  G-5 1 34     | .        | F-2 3 .  | C-6 6 20
  .            | .        | .        | C-6 6 20
  F-5 1 36     | D-4 2 24 | D-2 3 .  | C-3 4 40
  .            | .        | .        | C-6 6 20
  E-5 1 34     | .        | D-2 3 .  | C-6 6 20
  .            | .        | .        | C-6 6 20
  D-5 1 36     | G-4 2 24 | G-1 3 .  | C-5 5 36
  C-5 1 32     | .        | .        | C-5 5 20
  B-4 1 32     | .        | G-2 3 .  | C-5 5 28
  G-4 1 30     | .        | .        | C-5 5 36
}

uniform t1 t2 t3 kickE leadE shift

frame {
  t1 = beat * 0.6
  t2 = beat * 0.37
  t3 = beat * 0.21
  kickE = exp(-trig(3) * 10) * step(0.5, vel(3))
  leadE = exp(-trig(0) * 6)
  shift = floor(bar) * 0.07 + leadE * 0.08
}
pixel {
  # classic 4-term plasma on a low-res grid
  gx = floor(x * 64) / 64
  gy = floor(y * 40) / 40
  p1 = sin(gx * 9 + t1)
  p2 = sin(gy * 7 - t2)
  p3 = sin((gx + gy) * 6 + t3)
  p4 = sin(len(gx - 0.5 + 0.3 * sin(t3), gy - 0.5 + 0.3 * cos(t2)) * 14 - t1)
  pz = (p1 + p2 + p3 + p4) * 0.125 + 0.5
  # voronoi cells wash over it on the lead
  c = vor(gx * 8 + t3, gy * 5)
  pz = pz + (1 - c) * 0.25 * leadE
  # ordered dither then 7 hard colours
  dth = (hash(gx * 64 + gy * 2560) - 0.5) * 0.12
  pal(c64, fract(pz + shift + dth))
  cmul(0.7 + 0.5 * kickE)
}
